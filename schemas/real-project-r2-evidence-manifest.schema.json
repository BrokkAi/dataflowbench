{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataflowbench.dev/schemas/real-project-r2-evidence-manifest/v1",
  "title": "DataFlowBench R2 candidate evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "wave", "ghsa_id", "repository", "responses", "analyzer_evidence_consulted"],
  "properties": {
    "schema_version": { "const": 1 },
    "wave": { "const": "R2" },
    "ghsa_id": { "type": "string", "pattern": "^GHSA-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}$" },
    "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "responses": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/response" } },
    "analyzer_evidence_consulted": { "const": false }
  },
  "$defs": {
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["purpose", "path", "sha256", "bytes", "request_url", "http_status", "retrieved_at"],
      "properties": {
        "purpose": { "type": "string", "pattern": "^(repository|languages|commit-[0-9]{2}|compare-[0-9]{2}|license-vulnerable|license-fixed|readme-vulnerable)$" },
        "path": { "type": "string", "pattern": "^corpus/real-project/r2/evidence/GHSA-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}/.+\\.json$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "request_url": { "type": "string", "pattern": "^https://api\\.github\\.com/repos/" },
        "http_status": { "enum": [200, 404] },
        "retrieved_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
