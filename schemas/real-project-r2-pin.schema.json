{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataflowbench.dev/schemas/real-project-r2-pin/v2",
  "title": "DataFlowBench R2 selected-repository pin",
  "description": "An analyzer-free pin for one R2 draw selection. A pending-review pin makes no independent-review or ground-truth claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "wave",
    "pin_id",
    "lifecycle",
    "stratum",
    "language",
    "ecosystem",
    "repository",
    "advisory",
    "bindings",
    "fix_commits",
    "related_commits",
    "revisions",
    "license",
    "proposed_remediation",
    "ground_truth",
    "analyzer_evidence_consulted"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "wave": { "const": "R2" },
    "pin_id": {
      "type": "string",
      "pattern": "^dfb-rp-r2-[a-z0-9-]+$"
    },
    "lifecycle": {
      "enum": ["pending-review", "accepted", "declined"],
      "description": "pending-review is the honest state before both immutable independent reports exist."
    },
    "stratum": { "enum": ["java", "javascript", "python"] },
    "language": { "enum": ["java", "javascript", "python"] },
    "ecosystem": { "enum": ["maven", "npm", "pip"] },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "name", "url"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/[^/]+/[^/]+$"
        }
      }
    },
    "advisory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ghsa_id", "url", "cve_id", "cwes", "summary", "severity", "published_at", "affected_packages"],
      "properties": {
        "ghsa_id": {
          "type": "string",
          "pattern": "^GHSA-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}$"
        },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/advisories/GHSA-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}$"
        },
        "cve_id": { "type": ["string", "null"] },
        "cwes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^CWE-[0-9]+$" } },
        "summary": { "type": ["string", "null"] },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "published_at": { "type": "string", "format": "date-time" },
        "affected_packages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_manifest",
        "frame",
        "eligibility",
        "draw",
        "evidence_manifest",
        "draw_position",
        "draw_key",
        "selected_repository",
        "eligibility_candidate_index",
        "pin_evidence_manifest"
      ],
      "properties": {
        "snapshot_manifest": { "$ref": "#/$defs/r2_snapshot_manifest" },
        "frame": { "$ref": "#/$defs/r2_frame" },
        "eligibility": { "$ref": "#/$defs/r2_eligibility" },
        "draw": { "$ref": "#/$defs/r2_draw" },
        "evidence_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^corpus/real-project/r2/evidence/GHSA-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}/manifest\\.json$"
            },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "draw_position": { "type": "integer", "minimum": 1 },
        "draw_key": { "$ref": "#/$defs/sha256" },
        "selected_repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "eligibility_candidate_index": { "type": "integer", "minimum": 0 }
        ,
        "pin_evidence_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^corpus/real-project/r2/pin-evidence/GHSA-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}/manifest\\.json$"
            },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "fix_commits": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "evidence"],
        "properties": {
          "revision": { "$ref": "#/$defs/full_revision" },
          "evidence": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "related_commits": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["revision", "role", "evidence"],
        "properties": {
          "revision": { "$ref": "#/$defs/full_revision" },
          "role": { "enum": ["introduction-reference", "additional-fix-reference"] },
          "evidence": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "revisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vulnerable", "fixed"],
      "properties": {
        "vulnerable": { "$ref": "#/$defs/pinned_revision" },
        "fixed": { "$ref": "#/$defs/pinned_revision" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdx_id",
        "file_path",
        "vulnerable_content_sha256",
        "fixed_content_sha256",
        "identical_at_both_revisions",
        "vulnerable_bytes",
        "fixed_bytes",
        "evidence"
      ],
      "properties": {
        "spdx_id": {
          "enum": [
            "AGPL-3.0",
            "Apache-2.0",
            "BSD-2-Clause",
            "BSD-3-Clause",
            "BSL-1.0",
            "EPL-2.0",
            "GPL-2.0",
            "GPL-3.0",
            "ISC",
            "LGPL-2.1",
            "LGPL-3.0",
            "MIT",
            "MPL-2.0",
            "Unlicense",
            "Zlib"
          ]
        },
        "file_path": { "$ref": "#/$defs/safe_path" },
        "vulnerable_content_sha256": { "$ref": "#/$defs/sha256" },
        "fixed_content_sha256": { "$ref": "#/$defs/sha256" },
        "identical_at_both_revisions": { "type": "boolean" },
        "vulnerable_bytes": { "type": "integer", "minimum": 1 },
        "fixed_bytes": { "type": "integer", "minimum": 1 },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vulnerable", "fixed"],
          "properties": {
            "vulnerable": { "$ref": "#/$defs/artifact" },
            "fixed": { "$ref": "#/$defs/artifact" }
          }
        }
      }
    },
    "proposed_remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "file_path",
        "source_hint",
        "sink_hint",
        "candidate_basis"
      ],
      "properties": {
        "status": { "const": "proposed" },
        "file_path": { "$ref": "#/$defs/safe_path" },
        "source_hint": { "type": "string", "minLength": 1 },
        "sink_hint": { "type": "string", "minLength": 1 },
        "candidate_basis": {
          "type": "string",
          "minLength": 1,
          "description": "Source-only rationale; it must not cite analyzer output."
        }
      }
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "adjudication",
        "review_independence",
        "reviewers",
        "basis"
      ],
      "properties": {
        "status": { "enum": ["proposed", "accepted", "declined"] },
        "adjudication": {
          "enum": ["pending", "agreed", "adjudicated", "declined"]
        },
        "review_independence": {
          "enum": ["pending", "independent"],
          "description": "pending explicitly refuses to claim review authority."
        },
        "reviewers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "basis": { "type": "string", "minLength": 1 },
        "declined_reason": { "type": "string", "minLength": 1 }
      }
    },
    "analyzer_evidence_consulted": { "const": false }
  },
  "allOf": [
    {
      "if": { "properties": { "lifecycle": { "const": "pending-review" } } },
      "then": {
        "properties": {
          "ground_truth": {
            "properties": {
              "status": { "const": "proposed" },
              "adjudication": { "const": "pending" },
              "review_independence": { "const": "pending" },
              "reviewers": { "maxItems": 0 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ground_truth": {
            "properties": {
              "status": { "const": "declined" }
            }
          }
        }
      },
      "then": {
        "properties": {
          "ground_truth": {
            "required": ["status", "adjudication", "review_independence", "reviewers", "basis", "declined_reason"]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "full_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "safe_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(?:/|$)).+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/safe_path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "r2_snapshot_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "corpus/real-project/r2/snapshot/manifest.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "r2_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "corpus/real-project/r2/frame.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "r2_eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "corpus/real-project/r2/eligibility.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "r2_draw": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "corpus/real-project/r2/draw.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "pinned_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "role",
        "archive_url",
        "archive_sha256",
        "archive_bytes",
        "retrieved_on",
        "capture_record"
      ],
      "properties": {
        "revision": { "$ref": "#/$defs/full_revision" },
        "role": { "type": "string", "minLength": 1 },
        "archive_url": {
          "type": "string",
          "pattern": "^https://codeload\\.github\\.com/[^/]+/[^/]+/tar\\.gz/[0-9a-f]{40}$"
        },
        "archive_sha256": { "$ref": "#/$defs/sha256" },
        "archive_bytes": { "type": "integer", "minimum": 1 },
        "retrieved_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "capture_record": { "$ref": "#/$defs/artifact" }
      }
    }
  }
}
