{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataflowbench.dev/schemas/release-evidence-inventory/v1",
  "title": "DataFlowBench release evidence inventory v1",
  "description": "Digest-backed inventory for the v0.7.1 full refresh. It is assembled after evidence merges and never contains its own manifest commit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "evidence_revision",
    "baseline",
    "plan",
    "ledger",
    "artifacts",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "release": {
      "const": "v0.7.1"
    },
    "evidence_revision": {
      "$ref": "#/$defs/revision",
      "description": "The surviving merged evidence revision named by the manifest PR. It must be reachable from the validated main checkout."
    },
    "baseline": {
      "$ref": "#/$defs/baseline"
    },
    "ledger": {
      "$ref": "#/$defs/artifact",
      "description": "Committed execution ledger retaining every attempt."
    },
    "plan": {
      "$ref": "#/$defs/artifact",
      "description": "Committed preregistered expected inventory."
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cold-sidecars",
        "run-environments",
        "warm-observability",
        "warm-series",
        "invocation-overhead",
        "native-probes",
        "modeling-probes"
      ],
      "properties": {
        "cold-sidecars": {
          "$ref": "#/$defs/coverage"
        },
        "run-environments": {
          "$ref": "#/$defs/coverage"
        },
        "warm-observability": {
          "$ref": "#/$defs/coverage"
        },
        "warm-series": {
          "$ref": "#/$defs/coverage"
        },
        "invocation-overhead": {
          "$ref": "#/$defs/coverage"
        },
        "native-probes": {
          "$ref": "#/$defs/coverage"
        },
        "modeling-probes": {
          "$ref": "#/$defs/coverage"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "repo_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repo_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "commit",
        "fixture_revision",
        "cases",
        "reports",
        "results"
      ],
      "properties": {
        "tag": {
          "const": "v0.7.0"
        },
        "commit": {
          "const": "0a4d8b66c1e458b10e2c6196d0e4f9622f4c8ef5"
        },
        "fixture_revision": {
          "const": "sha256:9df209ed3d7723a3ee33f2b289cf2afe34a3add781bdf2a2ac445de42b8d0151"
        },
        "cases": {
          "const": 852
        },
        "reports": {
          "const": 82
        },
        "results": {
          "const": 3480
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "expected_ids",
        "retained_ids",
        "missing_ids",
        "ledger_ids",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "expected_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "retained_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missing_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ledger_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
