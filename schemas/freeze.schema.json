{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataflowbench.dev/schemas/freeze/v1",
  "title": "DataFlowBench immutable benchmark freeze v1",
  "description": "A release-evidence manifest. Every path and digest is checked against a clean checkout before a claim may be published.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark", "claim", "cases", "adapters", "reports"],
  "properties": {
    "schema_version": { "const": 1 },
    "benchmark": { "$ref": "#/$defs/benchmark" },
    "claim": { "$ref": "#/$defs/claim" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/adapter" }
    },
    "reports": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/report" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "fixture_revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "track": {
      "enum": ["value-flow", "taint", "typestate", "witness", "performance"]
    },
    "dimension": {
      "enum": ["value-flow", "taint", "typestate", "witness", "performance"]
    },
    "profile": {
      "enum": ["benchmark-controlled", "tool-native"]
    },
    "score_tier": {
      "enum": ["calibration", "core", "language-extension", "real-project"]
    },
    "outcome": {
      "enum": ["reached", "not-reached", "inconclusive", "unsupported", "runner-error"]
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "release", "case_schema_version", "result_schema_version", "fixture_revision", "dirty"],
      "properties": {
        "revision": { "$ref": "#/$defs/revision" },
        "release": { "type": "string", "minLength": 1 },
        "case_schema_version": { "type": "integer", "const": 2 },
        "result_schema_version": { "type": "integer", "const": 1 },
        "fixture_revision": { "$ref": "#/$defs/fixture_revision" },
        "dirty": { "const": false }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "tracks", "dimensions", "exclusions", "score_tiers", "model_profiles"],
      "properties": {
        "scope": { "enum": ["development", "release", "website"] },
        "tracks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/track" }
        },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dimension" }
        },
        "exclusions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "reason"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "score_tiers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/score_tier" }
        },
        "model_profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/profile" }
        }
      }
    },
    "fixture_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "fixture_digests", "track", "score_tier", "model_profile", "template_id", "polarity"],
      "properties": {
        "id": { "type": "string", "pattern": "^dfb-[a-z0-9-]+$" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "fixture_digests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/fixture_digest" }
        },
        "track": { "$ref": "#/$defs/track" },
        "score_tier": { "$ref": "#/$defs/score_tier" },
        "model_profile": { "$ref": "#/$defs/profile" },
        "template_id": { "type": "string", "minLength": 1 },
        "polarity": { "enum": ["positive", "negative"] }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tool", "tool_version", "build_identity", "adapter_version", "configuration_hash", "track", "dimension", "model_profile"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tool": { "type": "string", "minLength": 1 },
        "tool_version": { "type": "string", "minLength": 1 },
        "build_identity": { "type": "string", "minLength": 1 },
        "adapter_version": { "type": "string", "minLength": 1 },
        "configuration_hash": { "$ref": "#/$defs/sha256" },
        "track": { "$ref": "#/$defs/track" },
        "dimension": { "$ref": "#/$defs/dimension" },
        "model_profile": { "$ref": "#/$defs/profile" }
      }
    },
    "outcome_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "outcome"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "outcome": { "$ref": "#/$defs/outcome" }
      }
    },
    "raw_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "path", "sha256"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "normalized_report_sha256", "adapter", "track", "dimension", "model_profile", "case_ids", "outcomes", "raw_evidence"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "normalized_report_sha256": { "$ref": "#/$defs/sha256" },
        "adapter": { "type": "string", "minLength": 1 },
        "track": { "$ref": "#/$defs/track" },
        "dimension": { "$ref": "#/$defs/dimension" },
        "model_profile": { "$ref": "#/$defs/profile" },
        "case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/outcome_record" }
        },
        "raw_evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/raw_evidence" }
        }
      }
    }
  }
}
