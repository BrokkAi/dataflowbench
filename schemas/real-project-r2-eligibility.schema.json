{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataflowbench.dev/schemas/real-project-r2-eligibility/v2",
  "title": "DataFlowBench R2 complete eligibility decisions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "wave", "frame", "analyzer_evidence_consulted", "candidates"],
  "properties": {
    "schema_version": { "const": 2 },
    "wave": { "const": "R2" },
    "frame": { "$ref": "#/$defs/artifact" },
    "analyzer_evidence_consulted": { "const": false },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ghsa_id", "repository", "stratum", "draw_position", "decisions"],
        "properties": {
          "ghsa_id": { "type": "string", "pattern": "^GHSA-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}$" },
          "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
          "stratum": { "enum": ["java", "javascript", "python"] },
          "draw_position": { "type": "integer", "minimum": 1 },
          "decisions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["E1", "E2", "E3", "E4", "E5", "E6", "E7", "E8"],
            "properties": {
              "E1": { "$ref": "#/$defs/decision" },
              "E2": { "$ref": "#/$defs/decision" },
              "E3": { "$ref": "#/$defs/decision" },
              "E4": { "$ref": "#/$defs/decision" },
              "E5": { "$ref": "#/$defs/judgment" },
              "E6": { "$ref": "#/$defs/decision" },
              "E7": { "$ref": "#/$defs/decision" },
              "E8": { "$ref": "#/$defs/uniqueness" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "observed", "evidence"],
      "properties": {
        "outcome": { "enum": ["pass", "fail"] },
        "observed": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } }
      }
    },
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "observed", "evidence", "rationale"],
      "properties": {
        "outcome": { "enum": ["pass", "fail"] },
        "observed": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "uniqueness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "observed", "evidence", "selected_repositories_before"],
      "properties": {
        "outcome": { "enum": ["pass", "fail"] },
        "observed": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
        "selected_repositories_before": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[^/]+/[^/]+$" }
        }
      }
    }
  }
}
