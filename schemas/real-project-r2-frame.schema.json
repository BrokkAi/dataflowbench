{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataflowbench.dev/schemas/real-project-r2-frame/v2",
  "title": "DataFlowBench R2 advisory-derived frame",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "wave", "derived_from", "admission_rule", "counts", "candidates", "analyzer_evidence_consulted"],
  "properties": {
    "schema_version": { "const": 2 },
    "wave": { "const": "R2" },
    "derived_from": { "$ref": "#/$defs/artifact" },
    "admission_rule": { "type": "string", "minLength": 1 },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "admitted", "rejected"],
      "properties": {
        "raw": { "$ref": "#/$defs/counts" },
        "admitted": { "$ref": "#/$defs/counts" },
        "rejected": { "$ref": "#/$defs/counts" }
      }
    },
    "candidates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/candidate" } },
    "analyzer_evidence_consulted": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "counts": {
      "type": "object", "additionalProperties": false, "required": ["java", "javascript", "python"],
      "properties": {
        "java": { "type": "integer", "minimum": 0 },
        "javascript": { "type": "integer", "minimum": 0 },
        "python": { "type": "integer", "minimum": 0 }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "array_index"],
      "properties": {
        "path": { "type": "string", "pattern": "^corpus/real-project/r2/snapshot/advisories/(maven|npm|pip)/page-[0-9]{4}\\.json$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "array_index": { "type": "integer", "minimum": 0 }
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["stratum", "ecosystem", "ghsa_id", "cve_id", "cwes", "severity", "published_at", "repository", "source_code_location", "packages", "fix_commit_references", "advisory_evidence"],
      "properties": {
        "stratum": { "enum": ["java", "javascript", "python"] },
        "ecosystem": { "enum": ["maven", "npm", "pip"] },
        "ghsa_id": { "type": "string", "pattern": "^GHSA-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}$" },
        "cve_id": { "type": ["string", "null"] },
        "cwes": { "type": "array", "items": { "type": "string" } },
        "severity": { "type": ["string", "null"] },
        "published_at": { "type": ["string", "null"] },
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "source_code_location": { "type": "string", "minLength": 1 },
        "packages": { "type": "array", "items": { "type": "string" } },
        "fix_commit_references": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" } },
        "advisory_evidence": { "$ref": "#/$defs/evidence" }
      }
    }
  }
}
