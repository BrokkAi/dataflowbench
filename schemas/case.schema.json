{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataflowbench.dev/schemas/case/v2",
  "title": "DataFlowBench case v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "template_id",
    "polarity",
    "score_tier",
    "track",
    "language",
    "semantic_dimensions",
    "feature_tags",
    "model_profile",
    "fixture_files",
    "source_anchors",
    "sink_anchors",
    "expected_flows",
    "expected_nonflows",
    "expected_analysis_capability",
    "execution_budget",
    "fixture_provenance",
    "tool_model_references"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "id": { "type": "string", "pattern": "^dfb-[a-z0-9-]+$" },
    "template_id": {
      "type": "string",
      "pattern": "^dfb-template-[a-z0-9-]+$",
      "description": "Language-neutral semantic scenario shared by its positive and negative cases."
    },
    "polarity": { "enum": ["positive", "negative"] },
    "negative_mechanism": {
      "enum": [
        "unrelated-value",
        "overwrite-kill",
        "field-separation",
        "object-separation",
        "call-context-separation",
        "infeasible-path",
        "sanitizer"
      ]
    },
    "score_tier": {
      "enum": ["calibration", "core", "language-extension", "real-project"],
      "description": "Calibration cases validate adapters but never contribute to correctness scores."
    },
    "track": { "enum": ["value-flow", "taint", "typestate", "performance"] },
    "language": { "type": "string", "minLength": 1 },
    "semantic_dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "local-flow",
          "interprocedural-flow",
          "flow-sensitivity",
          "context-sensitivity",
          "heap-field-sensitivity",
          "object-sensitivity",
          "path-sensitivity",
          "exceptional-flow",
          "recursion",
          "external-summary",
          "sanitizer",
          "dynamic-dispatch",
          "asynchronous-flow"
        ]
      }
    },
    "feature_tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "intraprocedural",
          "interprocedural-one-hop",
          "interprocedural-deep",
          "heap-access-path",
          "recursive",
          "exceptional",
          "modeled-external",
          "ambiguous-dispatch",
          "sanitized",
          "summary-required"
        ]
      }
    },
    "model_profile": {
      "enum": ["benchmark-controlled", "tool-native"],
      "description": "Whether DataFlowBench supplies equivalent models or evaluates models shipped by the tool."
    },
    "fixture_files": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "source_anchors": { "$ref": "#/$defs/anchors" },
    "sink_anchors": { "$ref": "#/$defs/anchors" },
    "expected_flows": { "$ref": "#/$defs/flows" },
    "expected_nonflows": { "$ref": "#/$defs/flows" },
    "witness_checkpoints": {
      "type": "array",
      "items": { "type": "string", "pattern": "^DFB-" }
    },
    "expected_analysis_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "execution_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_clock_seconds"],
      "properties": {
        "wall_clock_seconds": { "type": "integer", "minimum": 1 },
        "peak_memory_mb": { "type": "integer", "minimum": 1 }
      }
    },
    "fixture_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "origin", "revision", "license"],
      "properties": {
        "kind": { "enum": ["authored", "imported"] },
        "origin": { "type": "string" },
        "revision": { "type": "string" },
        "license": { "type": "string" }
      }
    },
    "tool_model_references": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "policy": { "type": "string" },
          "unsupported_reason": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "polarity": { "const": "negative" } } },
      "then": { "required": ["negative_mechanism"] },
      "else": { "not": { "required": ["negative_mechanism"] } }
    }
  ],
  "$defs": {
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["marker", "file"],
        "properties": {
          "marker": { "type": "string", "pattern": "^DFB-" },
          "file": { "type": "string" },
          "line_hint": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "sink"],
        "properties": {
          "source": { "type": "string", "pattern": "^DFB-" },
          "sink": { "type": "string", "pattern": "^DFB-" }
        }
      }
    }
  }
}
