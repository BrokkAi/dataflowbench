# Rust build output and backups
/target/
**/*.rs.bk

# Operating-system metadata
.DS_Store
._*
Thumbs.db
Desktop.ini

# Editor and IDE state
.claude/
.idea/
.vscode/
*.swp
*.swo
*~

# Local environment and secrets
.env
.env.*
!.env.example

# Logs, coverage, and temporary files
*.log
# Digest-bound Joern Swift compiler inputs are retained benchmark evidence.
!/evidence/joern-swift/**/build.log
!/reports/raw/joern-swift-*/**/build.log
coverage/
.coverage
__pycache__/
*.py[cod]
*.tmp
*.temp

# Raw local Swift validation records; path-redacted publication copies are tracked.
/evidence/swift-fixtures/local-*/

# Retain the exact compiler commands consumed by Result CPG extraction.
!evidence/swift-v2-vendor-result-220/joern-result-*/build.log

# Retain the compiler command consumed by SwiftAstGen for v2 scored attempts.
!reports/raw/*-swift-v2-additions/**/build.log

# Compact smoke evidence is committed under evidence; full databases remain local.
/reports/raw/swift-v3/lane-smoke-01/
!/evidence/swift-v3-lane-smoke-01/**/*.log

# Retained local Swift runs and uncompressed audit copies; compact evidence is tracked.
/reports/raw/swift-v3/full108-20260928-01/
/reports/raw/swift-v3/budget8-75s-20260928-01/
/evidence/swift-v3-full108-60s-attempt-01/
/evidence/swift-v3-full108-60s-attempt-01-audit/

/evidence/swift-v3-budget8-75s-attempt-01-audit/

# Bounded endpoint diagnostics retain full native databases locally.
/reports/raw/swift-endpoints-v1/
