---
import type { Snapshot } from '../data/snapshots';

interface Props {
  snapshot: Snapshot;
}

const { snapshot } = Astro.props;

interface Row {
  template: string;
  language: string;
  scorecard: string;
  profile: string;
  tier: string;
  positive: string;
  negative: string;
}

const rows: Row[] = [];
for (const scorecard of snapshot.results.scorecards) {
  for (const language of scorecard.languages) {
    for (const tier of language.score_tiers) {
      const byTemplate = new Map<string, { positive?: string; negative?: string }>();
      for (const result of tier.cases) {
        const entry = byTemplate.get(result.template_id) ?? {};
        if (result.polarity === 'positive') entry.positive = result.outcome;
        else entry.negative = result.outcome;
        byTemplate.set(result.template_id, entry);
      }
      for (const [template, outcomes] of byTemplate) {
        rows.push({
          template: template.replace('dfb-template-', ''),
          language: language.language,
          scorecard: scorecard.id,
          profile: scorecard.model_profile,
          tier: tier.score_tier,
          positive: outcomes.positive ?? '—',
          negative: outcomes.negative ?? '—',
        });
      }
    }
  }
}
rows.sort(
  (left, right) =>
    left.template.localeCompare(right.template) ||
    left.language.localeCompare(right.language) ||
    left.scorecard.localeCompare(right.scorecard),
);
---

<div class="table-scroll ds-table">
  <table>
    <thead>
      <tr>
        <th>Semantic template</th>
        <th>Language</th>
        <th>Scorecard</th>
        <th>Model profile</th>
        <th>Tier</th>
        <th>Positive outcome</th>
        <th>Negative outcome</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <td class="template">
              <code>{row.template}</code>
            </td>
            <td>
              <code>{row.language}</code>
            </td>
            <td class="scorecard">
              <code>{row.scorecard}</code>
            </td>
            <td>
              <code>{row.profile}</code>
            </td>
            <td>{row.tier}</td>
            <td>
              <code>{row.positive}</code>
            </td>
            <td>
              <code>{row.negative}</code>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .table-scroll {
    overflow-x: auto;
  }
  /* Template and scorecard ids wrap at their hyphens, two or three lines to
     an id; below that the matrix pans instead of stacking one piece per
     line. */
  .template {
    min-width: 9.5rem;
  }
  .scorecard {
    min-width: 10.5rem;
  }
  /* Seven columns of short terms: the tighter gap the foundation gives tables
     of eight or more keeps both id columns their room at 1440px. */
  table :is(th, td):not(:last-child) {
    padding-inline-end: 0.7rem;
  }
</style>
