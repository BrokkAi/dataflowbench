---
import { evidenceUrl, shortDigest, type Snapshot } from '../data/snapshots';

interface Props {
  snapshot: Snapshot;
}

const { snapshot } = Astro.props;
const { benchmark, manifest, claim } = snapshot.results;
---

<div class="snapshot-banner">
  <p>
    <strong>Frozen snapshot {snapshot.version}</strong>
    {snapshot.current && <span class="current-pill">current</span>}
  </p>
  <ul>
    <li>
      Freeze ID:
      <a href={evidenceUrl(snapshot, manifest.path)}
        ><code>{shortDigest(manifest.sha256)}…</code></a
      >
      (SHA-256 of <code>{manifest.path}</code>)
    </li>
    <li>
      Benchmark revision <code>{shortDigest(benchmark.revision)}</code>, release
      <code>{benchmark.release}</code>, claim scope <code>{claim.scope}</code>
    </li>
    <li>
      Fixture revision <code>{shortDigest(benchmark.fixture_revision.replace('sha256:', ''))}…</code>
    </li>
  </ul>
</div>

<style>
  .snapshot-banner {
    border: 1px solid var(--ds-line);
    border-inline-start: 2px solid var(--ds-accent);
    border-radius: 0 var(--ds-cut-control) var(--ds-cut-control) 0;
    corner-shape: bevel;
    padding: 0.85rem 1.1rem;
    background: var(--ds-surface);
  }
  .snapshot-banner ul {
    margin: 0.25rem 0 0;
  }
  .current-pill {
    display: inline-block;
    margin-inline-start: 0.5rem;
    padding: 0.05rem 0.45rem;
    border: 1px solid var(--ds-accent-line);
    border-radius: var(--ds-cut-badge);
    corner-shape: bevel;
    font-size: var(--sl-text-xs);
    font-weight: 500;
    background: var(--ds-accent-low);
    color: var(--ds-accent-text);
  }
</style>
