---
// The results-first landing view. Every number below is computed from the
// generated results model of the current frozen snapshot — interpretation is
// hand-written per snapshot, counts and rates never are.
import {
  coreKernelPopulations,
  currentSnapshot,
  evidenceUrl,
  percentCell,
  shortDigest,
  vendorColorClass,
  vendorName,
  toolVersionLabel,
  type Scorecard,
  type ScoreTier,
} from '../data/snapshots';
import SnapshotEvolution from './SnapshotEvolution.astro';
import LatencyRanking from './LatencyRanking.astro';

const snapshot = currentSnapshot;
const scorecards = snapshot.results.scorecards;
// The breadth baseline is the all-language smoke population; the deep kernels
// live in their own per-language scorecards (Java and JavaScript still ride
// along in the smoke report). Populations are matched by case identity below,
// never by language name alone.
const smoke = scorecards.find((card) => card.id.startsWith('bifrost-smoke'))!;

interface VendorStats {
  /** Adapter tool identifier, e.g. `bifrost`. */
  tool: string;
  /** Display name, e.g. `Bifrost`. */
  name: string;
  toolVersion: string;
  scorecardId: string;
  /** Decisive outcomes: the 2×2 confusion matrix. */
  truePositives: number;
  falseNegatives: number;
  falsePositives: number;
  trueNegatives: number;
  /** Coverage outcomes — never folded into the matrix. */
  inconclusive: number;
  unsupported: number;
  runnerErrors: number;
  total: number;
  correct: number;
  wrong: number;
  incomplete: number;
  /** Micro rates over this tier's own matrix. */
  tpr: string | null;
  fpr: string | null;
  /** The published dimension-macro rates for the same tier. */
  tprMacro: string | null;
  fprMacro: string | null;
}

function rate(numerator: number, denominator: number): string | null {
  if (denominator === 0) return null;
  return ((100 * numerator) / denominator).toFixed(1);
}

function statsOf(card: Scorecard, tier: ScoreTier): VendorStats {
  let truePositives = 0;
  let falseNegatives = 0;
  let falsePositives = 0;
  let trueNegatives = 0;
  let inconclusive = 0;
  let unsupported = 0;
  let runnerErrors = 0;
  for (const result of tier.cases) {
    switch (result.classification) {
      case 'true-positive':
        truePositives += 1;
        break;
      case 'false-negative':
        falseNegatives += 1;
        break;
      case 'false-positive':
        falsePositives += 1;
        break;
      case 'true-negative':
        trueNegatives += 1;
        break;
      case 'unsupported':
        unsupported += 1;
        break;
      case 'runner-error':
        runnerErrors += 1;
        break;
      default:
        inconclusive += 1;
    }
  }
  return {
    tool: card.adapter.tool,
    name: vendorName(card.adapter.tool),
    toolVersion: toolVersionLabel(card.adapter.tool, card.adapter.tool_version),
    scorecardId: card.id,
    truePositives,
    falseNegatives,
    falsePositives,
    trueNegatives,
    inconclusive,
    unsupported,
    runnerErrors,
    total: tier.cases.length,
    correct: truePositives + trueNegatives,
    wrong: falsePositives + falseNegatives,
    incomplete: inconclusive + unsupported + runnerErrors,
    tpr: rate(truePositives, truePositives + falseNegatives),
    fpr: rate(falsePositives, falsePositives + trueNegatives),
    tprMacro: tier.dimension_macro.true_positive_rate_percent,
    fprMacro: tier.dimension_macro.false_positive_rate_percent,
  };
}

// One kernel per core population, carrying however many analyzers cover
// exactly the same case identifiers. The population filter itself lives in
// `data/snapshots` so that the cross-snapshot evolution graph below reads the
// exact same no-pooling population as these cards.
interface Kernel {
  /** Stable per-population id used to link a card to its dialog payload. */
  id: string;
  language: string;
  templates: number;
  cases: number;
  vendors: VendorStats[];
  tiers: { vendor: VendorStats; tier: ScoreTier }[];
}

const kernels: Kernel[] = coreKernelPopulations(snapshot.results).map(
  (population) => {
    const tiers = [...population.entries.values()]
      .map((entry) => ({
        vendor: statsOf(entry.card, entry.tier),
        tier: entry.tier,
      }))
      .sort((left, right) => left.vendor.name.localeCompare(right.vendor.name));
    return {
      id: '',
      language: population.language,
      templates: population.templates,
      cases: population.cases,
      vendors: tiers.map((entry) => entry.vendor),
      tiers,
    } satisfies Kernel;
  },
);
kernels.forEach((kernel, index) => {
  kernel.id = `kernel-${index}`;
});

// Core sizes differ per language. Two sizes read naturally as a range; more
// than two have to be enumerated, or "24–29" would imply sizes nobody has.
const templateSizeList = [...new Set(kernels.map((kernel) => kernel.templates))]
  .sort((left, right) => left - right);
const templateSizes =
  templateSizeList.length <= 2
    ? templateSizeList.join('–')
    : `${templateSizeList.slice(0, -1).join(', ')} or ${templateSizeList.at(-1)}`;

// Payload for the details dialog: embedded at build time, so the page stays
// fully static and the dialog needs no network access.
const dialogData = kernels.map((kernel) => ({
  id: kernel.id,
  language: kernel.language,
  templates: kernel.templates,
  cases: kernel.cases,
  vendors: kernel.vendors.map((vendor) => ({
    tool: vendor.tool,
    name: vendor.name,
    // Resolved server-side from the one shared vendor→colour identity map, so
    // the dialog cannot drift from the cards it opened out of.
    colorClass: vendorColorClass(vendor.tool, 0),
    toolVersion: vendor.toolVersion,
    scorecardId: vendor.scorecardId,
    truePositives: vendor.truePositives,
    falseNegatives: vendor.falseNegatives,
    falsePositives: vendor.falsePositives,
    trueNegatives: vendor.trueNegatives,
    inconclusive: vendor.inconclusive,
    unsupported: vendor.unsupported,
    runnerErrors: vendor.runnerErrors,
    tpr: percentCell(vendor.tpr),
    fpr: percentCell(vendor.fpr),
    tprMacro: percentCell(vendor.tprMacro),
    fprMacro: percentCell(vendor.fprMacro),
  })),
}));

// Direct-flow breadth: the direct-propagation template pair per language.
const directTemplate = 'dfb-template-direct-propagation';
interface BreadthRow {
  language: string;
  positive: string;
  negative: string;
  correct: boolean;
  incomplete: boolean;
}
const breadth: BreadthRow[] = [];
for (const language of smoke.languages) {
  for (const tier of language.score_tiers) {
    if (tier.score_tier !== 'core') continue;
    const pair = tier.cases.filter(
      (result) => result.template_id === directTemplate,
    );
    if (pair.length === 0) continue;
    const positive = pair.find((result) => result.polarity === 'positive');
    const negative = pair.find((result) => result.polarity === 'negative');
    const classifications = pair.map((result) => result.classification);
    breadth.push({
      language: language.language,
      positive: positive?.outcome ?? '—',
      negative: negative?.outcome ?? '—',
      correct:
        classifications.filter(
          (c) => c === 'true-positive' || c === 'true-negative',
        ).length === 2,
      incomplete: classifications.some(
        (c) =>
          c === 'inconclusive' || c === 'unsupported' || c === 'runner-error',
      ),
    });
  }
}
breadth.sort((left, right) => left.language.localeCompare(right.language));
const breadthCorrect = breadth.filter((row) => row.correct).length;
const breadthIncomplete = breadth.filter((row) => row.incomplete);

// Per-kernel template outcomes, one column pair per analyzer covering the
// population.
interface KernelRow {
  template: string;
  cells: { positive: string; negative: string }[];
}
function kernelTable(kernel: Kernel): KernelRow[] {
  const rows = new Map<string, KernelRow>();
  kernel.tiers.forEach((entry, index) => {
    for (const result of entry.tier.cases) {
      const template = result.template_id.replace('dfb-template-', '');
      let row = rows.get(template);
      if (!row) {
        row = {
          template,
          cells: kernel.tiers.map(() => ({
            positive: '—',
            negative: '—',
          })),
        };
        rows.set(template, row);
      }
      if (result.polarity === 'positive') row.cells[index]!.positive = result.outcome;
      else row.cells[index]!.negative = result.outcome;
    }
  });
  return [...rows.values()].sort((left, right) =>
    left.template.localeCompare(right.template),
  );
}

// A card's headline fraction is correct-of-population. For an analyzer that
// declines part of the population, that fraction alone reads as a low score
// rather than as a bounded profile, so the card also states the decided
// fraction and names *why* the rest is absent — declared-capability declines
// (`unsupported`) are a design position, not a miss.
function coverageNote(vendor: VendorStats): string {
  const parts: string[] = [];
  if (vendor.unsupported > 0) parts.push(`${vendor.unsupported} declined`);
  if (vendor.inconclusive > 0) parts.push(`${vendor.inconclusive} incomplete`);
  if (vendor.runnerErrors > 0) parts.push(`${vendor.runnerErrors} runner-error`);
  return `${vendor.name}: ${parts.join(', ')}`;
}

const outcomeClass = (polarity: 'positive' | 'negative', outcome: string) => {
  if (polarity === 'positive' && outcome === 'reached') return 'good';
  if (polarity === 'negative' && outcome === 'not-reached') return 'good';
  if (outcome === 'reached' || outcome === 'not-reached') return 'bad';
  return 'incomplete';
};

// The modeling matrix and the tool-native probe set are separate populations
// from the kernels above and from each other. They are built here as their own
// row sets, rendered in their own sections, and never merged into the kernel
// cards, the confusion dialog, or any shared denominator. A tier that a tool's
// own model surface cannot express is `unsupported` before the tool runs, so
// the scored partition — not the ratio inside it — is the load-bearing number.
interface TierRow {
  tool: string;
  name: string;
  toolVersion: string;
  colorClass: string;
  language: string;
  scorecardId: string;
  /** Assertions in the population, scored and declined together. */
  total: number;
  /** Assertions the tool's partition scores at all. */
  scored: number;
  /** Scored assertions that got a definitive answer. */
  decided: number;
  correct: number;
  falsePositives: number;
  falseNegatives: number;
  inconclusive: number;
  unsupported: number;
}

function tierRows(profile: string, idFragment: string): TierRow[] {
  const rows: TierRow[] = [];
  for (const card of scorecards) {
    if (card.model_profile !== profile) continue;
    if (!card.id.includes(idFragment)) continue;
    for (const language of card.languages) {
      for (const tier of language.score_tiers) {
        const counts = { tp: 0, tn: 0, fp: 0, fn: 0, inc: 0, uns: 0 };
        for (const result of tier.cases) {
          if (result.classification === 'true-positive') counts.tp += 1;
          else if (result.classification === 'true-negative') counts.tn += 1;
          else if (result.classification === 'false-positive') counts.fp += 1;
          else if (result.classification === 'false-negative') counts.fn += 1;
          else if (result.outcome === 'inconclusive') counts.inc += 1;
          else counts.uns += 1;
        }
        const decided = counts.tp + counts.tn + counts.fp + counts.fn;
        rows.push({
          tool: card.adapter.tool,
          name: vendorName(card.adapter.tool),
          toolVersion: toolVersionLabel(card.adapter.tool, card.adapter.tool_version),
          colorClass: vendorColorClass(card.adapter.tool, 0),
          language: language.language,
          scorecardId: card.id,
          total: tier.cases.length,
          scored: decided + counts.inc,
          decided,
          correct: counts.tp + counts.tn,
          falsePositives: counts.fp,
          falseNegatives: counts.fn,
          inconclusive: counts.inc,
          unsupported: counts.uns,
        });
      }
    }
  }
  rows.sort(
    (left, right) =>
      left.name.localeCompare(right.name) ||
      left.language.localeCompare(right.language),
  );
  return rows;
}

const modelingRows = tierRows('benchmark-controlled', '-modeling-');
const nativeRows = tierRows('tool-native', '-native-');

/** How a row reads when nothing in it was scored: coverage, not a zero. */
function tierVerdict(row: TierRow): string {
  if (row.scored === 0) return 'declines the tier — declared coverage';
  if (row.decided === 0) return 'scored, none decided';
  return `${row.correct}/${row.decided} decided correctly`;
}

const caseCount = snapshot.results.scorecards
  .flatMap((card) => card.languages)
  .flatMap((language) => language.score_tiers)
  .reduce((sum, tier) => sum + tier.cases.length, 0);
---

<p class="eyebrow">
  Immutable evaluation · DataFlowBench {snapshot.version}
</p>

<aside class="short-answer">
  <p class="label">Short answer</p>
  <p class="verdict">
    Nobody is perfect on the expanded cores. No analyzer answers a whole core
    correctly in any of the {kernels.length} languages. This snapshot doubles
    the field to eight analyzers, and the newcomers arrive strong on the JVM
    kernels: OpenTaint posts the best Kotlin row in the benchmark (50 of 58
    correct) and a near-top Java row (49 of 58, one behind Infer's
    field-leading 50), FlowDroid lands 49 in both, and every one of those
    rows is fully decisive — no incompletes. Infer also becomes C and C++'s
    second engine, and Pysa Python's third. Bifrost still decides far more
    than two freezes ago — every earlier runner error is gone and its
    decisive-correct count roughly doubled — and keeps the only zero
    false-positive JVM rows, at the cost of inconclusives its competitors
    don't record; its four new path-feasibility and loop-kill false positives
    are filed upstream and published here rather than filtered out. CodeQL
    and Joern answer everything definitively and miss where their
    approximations bind; Semgrep CE declines by declared capability what its
    intraprocedural profile does not cover.
  </p>
  <p>
    Below the kernels sit two further populations: the
    <strong>modeling matrix</strong>, which asks whether each tool's own
    model-declaration surface is load-bearing, and the
    <strong>tool-native probes</strong>, which ask what each product decides
    with nothing supplied by us. This snapshot also publishes the
    <strong>latency tier</strong> for the first time — descriptive per-case
    timings on a stated machine, kept strictly beside the correctness
    results. All populations have separate denominators. There is no
    combined leaderboard, and benchmark-controlled results are never pooled
    with, or compared number-to-number against, tool-native ones.
  </p>
  <p>
    DataFlowBench is <a href="https://github.com/BrokkAi">BrokkAi</a>'s own
    benchmark: we build it to measure where
    <a href="https://brokk.ai">Bifrost</a> stands against other analyzers, and
    to keep ourselves honest while doing it. The methodology is deliberately
    analyzer-neutral — every number below is generated from digest-bound
    freeze evidence that we cannot edit after the fact, misses and crashes
    included — but the motivation is not neutral, and we would rather say so.
  </p>
  <p>
    Each kernel poses one positive and one negative assertion per semantic
    template, and each language's kernel is its own population — cores of
    {templateSizes} templates, never pooled or ranked against each other, and
    never compared with the smaller cores of an earlier snapshot. Because every
    pair is balanced, an analyzer that always answers the same way — or answers
    blindly where it cannot see a construct — scores exactly half on the
    affected pairs: read correctness against that 50% blind baseline, and read
    approximation character from each vendor's TPR/FPR split in the details
    dialog. A blank
    analyzer on a kernel means no report in this freeze: no extractor, no
    frontend, or no adapter, which is coverage rather than a score.
  </p>
  <p>
    On the direct-flow breadth baseline, Bifrost answered both assertions
    correctly in <strong>{breadthCorrect} of {breadth.length}</strong>
    languages{breadthIncomplete.length > 0
      ? ` (${breadthIncomplete.map((row) => row.language).join(', ')}: inconclusive, which is reported as coverage — not as a wrong answer).`
      : '.'}
  </p>
</aside>

<div class="stat-grid">
  {kernels.map((kernel) => (
    <div
      class:list={[
        'stat-card',
        'kernel-card',
        { many: kernel.vendors.length > 2, dense: kernel.vendors.length > 3 },
      ]}
    >
      <p class="label">{kernel.language} kernel · correct decisions</p>
      <div class="stat-pair">
        {kernel.vendors.map((vendor, index) => (
          <div class={`vendor ${vendorColorClass(vendor.tool, index)}`}>
            <p class="who">{vendor.name}</p>
            <p class="big">{vendor.correct}<span class="of">/{vendor.total}</span></p>
            {vendor.incomplete > 0 && (
              <p class="decided">
                {vendor.correct} of {vendor.correct + vendor.wrong} decided
              </p>
            )}
          </div>
        ))}
      </div>
      <p class="caption">
        {kernel.vendors.some((vendor) => vendor.incomplete > 0)
          ? `${kernel.templates} templates · unanswered outcomes (${kernel.vendors
              .filter((vendor) => vendor.incomplete > 0)
              .map(coverageNote)
              .join('; ')}) are coverage, excluded from correctness and never
              counted against it`
          : `${kernel.templates} templates · all outcomes definitive`}
      </p>
      <p class="card-action">
        <button
          type="button"
          class="details-button"
          data-kernel={kernel.id}
          aria-label={`View details for the ${kernel.language} kernel`}
        >
          View details
        </button>
      </p>
    </div>
  ))}
  <div class="stat-card">
    <p class="label">Direct-flow breadth · languages fully correct</p>
    <div class="stat-pair">
      <div class="vendor v0">
        <p class="who">Bifrost</p>
        <p class="big">{breadthCorrect}<span class="of">/{breadth.length}</span></p>
      </div>
    </div>
    <p class="caption">
      one positive and one negative direct-propagation assertion per language
    </p>
  </div>
</div>

<dialog id="kernel-dialog" aria-labelledby="kernel-dialog-title">
  <div class="dialog-head">
    <div>
      <p class="label">Confusion matrix · DataFlowBench {snapshot.version}</p>
      <h2 id="kernel-dialog-title"></h2>
      <p class="caption" id="kernel-dialog-denominator"></p>
    </div>
    <button type="button" class="dialog-close" aria-label="Close" autofocus>×</button>
  </div>
  <div class="panel-grid" id="kernel-dialog-panels"></div>
  <p class="caption dialog-foot">
    Decisive outcomes only. <code>inconclusive</code>,
    <code>unsupported</code> and <code>runner-error</code> are capability
    coverage: they are excluded from the matrix and from the rates, and are
    never converted into clean negatives.
  </p>
</dialog>

<script
  type="application/json"
  id="kernel-dialog-data"
  is:inline
  set:html={JSON.stringify(dialogData)}></script>

<script>
  const payload = document.getElementById('kernel-dialog-data');
  const dialog = document.getElementById('kernel-dialog');
  const panels = document.getElementById('kernel-dialog-panels');
  const title = document.getElementById('kernel-dialog-title');
  const denominator = document.getElementById('kernel-dialog-denominator');

  if (
    payload instanceof HTMLScriptElement &&
    dialog instanceof HTMLDialogElement &&
    panels &&
    title &&
    denominator
  ) {
    interface VendorPayload {
      tool: string;
      name: string;
      colorClass: string;
      toolVersion: string;
      scorecardId: string;
      truePositives: number;
      falseNegatives: number;
      falsePositives: number;
      trueNegatives: number;
      inconclusive: number;
      unsupported: number;
      runnerErrors: number;
      tpr: string;
      fpr: string;
      tprMacro: string;
      fprMacro: string;
    }
    interface KernelPayload {
      id: string;
      language: string;
      templates: number;
      cases: number;
      vendors: VendorPayload[];
    }

    const kernels: KernelPayload[] = JSON.parse(payload.textContent || '[]');
    let opener: HTMLElement | null = null;

    const element = (tag: string, className?: string, text?: string) => {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text !== undefined) node.textContent = text;
      return node;
    };

    const cell = (
      row: HTMLElement,
      value: number,
      abbreviation: string,
      tone: string,
    ) => {
      const td = element('td', `matrix-cell ${tone}`);
      td.appendChild(element('span', 'matrix-count', String(value)));
      td.appendChild(element('span', 'matrix-tag', abbreviation));
      row.appendChild(td);
    };

    const buildPanel = (vendor: VendorPayload) => {
      const panel = element('section', `panel ${vendor.colorClass}`);
      const head = element('div', 'panel-head');
      head.appendChild(element('p', 'who', vendor.name));
      head.appendChild(element('p', 'caption', vendor.toolVersion));
      panel.appendChild(head);

      const table = element('table', 'matrix');
      const thead = element('thead');
      const headRow = element('tr');
      headRow.appendChild(element('td', 'matrix-corner'));
      const reached = element('th', undefined, 'reached');
      reached.setAttribute('scope', 'col');
      const notReached = element('th', undefined, 'not-reached');
      notReached.setAttribute('scope', 'col');
      headRow.appendChild(reached);
      headRow.appendChild(notReached);
      thead.appendChild(headRow);
      table.appendChild(thead);

      const tbody = element('tbody');
      const positiveRow = element('tr');
      const positiveHeader = element('th', undefined, 'positive');
      positiveHeader.setAttribute('scope', 'row');
      positiveRow.appendChild(positiveHeader);
      cell(positiveRow, vendor.truePositives, 'TP', 'good');
      cell(positiveRow, vendor.falseNegatives, 'FN', 'bad');
      const negativeRow = element('tr');
      const negativeHeader = element('th', undefined, 'negative');
      negativeHeader.setAttribute('scope', 'row');
      negativeRow.appendChild(negativeHeader);
      cell(negativeRow, vendor.falsePositives, 'FP', 'bad');
      cell(negativeRow, vendor.trueNegatives, 'TN', 'good');
      tbody.appendChild(positiveRow);
      tbody.appendChild(negativeRow);
      table.appendChild(tbody);
      panel.appendChild(table);

      const rates = element('div', 'rates');
      const tprBlock = element('div');
      tprBlock.appendChild(element('p', 'rate-label', 'TPR'));
      tprBlock.appendChild(element('p', 'rate-value', vendor.tpr));
      const fprBlock = element('div');
      fprBlock.appendChild(element('p', 'rate-label', 'FPR'));
      fprBlock.appendChild(element('p', 'rate-value', vendor.fpr));
      rates.appendChild(tprBlock);
      rates.appendChild(fprBlock);
      panel.appendChild(rates);
      panel.appendChild(
        element(
          'p',
          'caption',
          `TP/(TP+FN) and FP/(FP+TN) over this population. Published dimension-macro rates: TPR ${vendor.tprMacro}, FPR ${vendor.fprMacro}.`,
        ),
      );

      const coverage = element('div', 'coverage');
      coverage.appendChild(
        element('p', 'coverage-label', 'Coverage · excluded from the matrix'),
      );
      const items = element('ul', 'coverage-items');
      const entries: [string, number][] = [
        ['inconclusive', vendor.inconclusive],
        ['unsupported', vendor.unsupported],
        ['runner-error', vendor.runnerErrors],
      ];
      for (const [name, value] of entries) {
        const item = element('li');
        item.appendChild(element('span', 'coverage-count', String(value)));
        item.appendChild(element('span', 'coverage-name', name));
        items.appendChild(item);
      }
      coverage.appendChild(items);
      panel.appendChild(coverage);
      panel.appendChild(element('p', 'caption scorecard', vendor.scorecardId));
      return panel;
    };

    const open = (id: string, button: HTMLElement) => {
      const kernel = kernels.find((candidate) => candidate.id === id);
      if (!kernel) return;
      title.textContent = `${kernel.language} kernel`;
      denominator.textContent = `${kernel.templates} semantic templates · ${kernel.cases} assertions · ${kernel.vendors.length} ${
        kernel.vendors.length === 1 ? 'analyzer' : 'analyzers'
      }`;
      panels.textContent = '';
      for (const vendor of kernel.vendors) {
        panels.appendChild(buildPanel(vendor));
      }
      opener = button;
      dialog.showModal();
    };

    for (const button of document.querySelectorAll('.details-button')) {
      button.addEventListener('click', () => {
        const id = button.getAttribute('data-kernel');
        if (id) open(id, button as HTMLElement);
      });
    }

    // Whichever way the dialog is dismissed, focus returns to the card that
    // opened it.
    const restore = () => {
      const target = opener;
      opener = null;
      if (target) target.focus();
    };
    const dismiss = () => {
      dialog.close();
      restore();
    };

    // Backdrop clicks land on the dialog element itself.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dismiss();
    });
    dialog.querySelector('.dialog-close')?.addEventListener('click', dismiss);
    // Esc closes natively: `cancel` fires first, `close` after. Either one
    // restores focus, and `restore` is idempotent.
    dialog.addEventListener('cancel', () => window.setTimeout(restore, 0));
    dialog.addEventListener('close', restore);
  }
</script>

<h2>What this result means</h2>

<p>
  DataFlowBench measures whether analyzers correctly decide semantic
  data-flow questions — and whether they stay quiet when they should. Cases
  are balanced positive/negative pairs of language-neutral semantic templates
  (aliasing, kills, call context, branch joins, exception paths, …). The
  kernels and the modeling matrix run under a
  <code>benchmark-controlled</code> model profile, so the engines are compared
  under a common contract; the tool-native probes run under a
  <code>tool-native</code> profile, measuring the shipped product instead. The
  two profiles answer different questions and are never combined.
</p>

<p>
  This snapshot's bounded claim covers the synthetic direct-flow breadth
  baseline and the propagation kernels of the {kernels.length} kernel
  languages above on the <code>taint</code> track, plus the modeling matrix
  and the tool-native probe set in java, javascript, and python. Cores are
  sized per language ({templateSizes} templates), so each kernel is read on
  its own denominator; language-only constructs are reported in separate
  <code>language-extension</code> tiers on the snapshot pages. It does not
  estimate real-project accuracy or other languages' kernel behavior;
  performance is characterized separately in the latency tier, on its own
  terms, and never folded into these scores. The tool-native rows describe shipped coverage on six
  probe templates rather than product accuracy at large.
  <code>inconclusive</code>, <code>unsupported</code>, and
  <code>runner-error</code> are capability coverage and are never converted
  into clean negatives.
</p>

