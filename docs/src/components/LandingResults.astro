    flex: 0 0 auto;
    /* Starlight's content flow adds margin-top to sibling blocks. */
    margin-top: 0 !important;
  }
  .stat-pair p {
    margin-top: 0 !important;
  }
  .who {
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
