    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
  .tile {
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
  }
  .tile .big {
    font-size: 1.75rem;
  }
