---
// Cross-snapshot evolution of the benchmark-controlled kernel population.
//
// Every number here is derived at build time from the archived `results.json`
// of each freeze (and the current one), through the *same* no-pooling
// population filter the landing cards use — `coreKernelPopulations`. Nothing
// on this page is hand-entered, and nothing is pooled: benchmark-controlled
// kernels only, `core` tiers only, one series per analyzer, no combined score.
import {
  snapshots,
  analyzerCohort,
  coreKernelPopulations,
  vendorColorClass,
  vendorName,
  vendorOrder,
  type AnalyzerCohort,
} from '../data/snapshots';

interface Props {
  cohort: AnalyzerCohort;
  heading?: boolean;
}

const { cohort, heading = false } = Astro.props;
const cohortLabel = cohort === 'generalist' ? 'Generalists' : 'Specialists';
const cohortDescription =
  cohort === 'generalist'
    ? 'analyzers spanning several language ecosystems'
    : 'Analyzers deliberately focused on one ecosystem or a small related family';
const scope = cohort === 'generalist' ? 'generalists' : 'specialists';

interface SeriesPoint {
  version: string;
  slug: string;
  /** Decisive-correct: true positives plus true negatives. */
  correct: number;
  /** Decisive outcomes of any kind: TP + TN + FP + FN. */
  decided: number;
  /** Decisive but wrong: FP + FN. */
  wrong: number;
  /** Coverage outcomes — never plotted as negatives, never as zeroes. */
  incomplete: number;
  /** Assertions in the kernels this analyzer actually reported on. */
  covered: number;
  /** Kernels this analyzer covers, of the snapshot's kernels. */
  kernels: number;
}

interface Series {
  tool: string;
  name: string;
  colorClass: string;
  points: SeriesPoint[];
}

interface SnapshotColumn {
  version: string;
  slug: string;
  /** The snapshot's whole benchmark-controlled core population. */
  population: number;
  kernels: number;
  languages: number;
}

// Oldest first: the registry is newest-first for the sidebar's sake.
const timeline = [...snapshots].reverse();

const allColumns: SnapshotColumn[] = [];
const byTool = new Map<string, SeriesPoint[]>();

for (const snapshot of timeline) {
  const populations = coreKernelPopulations(snapshot.results);
  const population = populations.reduce((sum, entry) => sum + entry.cases, 0);
  allColumns.push({
    version: snapshot.version,
    slug: snapshot.slug,
    population,
    kernels: populations.length,
    languages: new Set(populations.map((entry) => entry.language)).size,
  });

  const totals = new Map<string, SeriesPoint>();
  for (const entry of populations) {
    for (const [tool, coverage] of entry.entries) {
      let point = totals.get(tool);
      if (!point) {
        point = {
          version: snapshot.version,
          slug: snapshot.slug,
          correct: 0,
          decided: 0,
          wrong: 0,
          incomplete: 0,
          covered: 0,
          kernels: 0,
        };
        totals.set(tool, point);
      }
      for (const result of coverage.tier.cases) {
        switch (result.classification) {
          case 'true-positive':
          case 'true-negative':
            point.correct += 1;
            point.decided += 1;
            break;
          case 'false-positive':
          case 'false-negative':
            point.wrong += 1;
            point.decided += 1;
            break;
          default:
            // inconclusive, unsupported, runner-error: capability coverage.
            point.incomplete += 1;
        }
      }
      point.covered += entry.cases;
      point.kernels += 1;
    }
  }
  // An analyzer absent from a snapshot gets no entry at all — no zero point,
  // and the line below simply does not pass through this column.
  for (const [tool, point] of totals) {
    const points = byTool.get(tool) ?? [];
    points.push(point);
    byTool.set(tool, points);
  }
}

const series: Series[] = [...byTool.entries()]
  .map(([tool, points]) => ({
    tool,
    name: vendorName(tool),
    colorClass: vendorColorClass(tool),
    points,
  }))
  .sort(
    (left, right) =>
      vendorOrder(left.tool) - vendorOrder(right.tool) ||
      left.name.localeCompare(right.name),
  );
const cohortSeries = series.filter((entry) => analyzerCohort(entry.tool) === cohort);
// Do not draw empty historical columns in a cohort facet. Specialists first
// entered the benchmark in v0.6.0, so earlier freezes carry neither a point
// nor a meaningful cohort comparison. Their full benchmark populations still
// contribute to the shared y-axis below, keeping the two facets comparable.
const cohortVersions = new Set(
  cohortSeries.flatMap((entry) => entry.points.map((point) => point.version)),
);
const columns = allColumns.filter((column) => cohortVersions.has(column.version));

// ---- Geometry -------------------------------------------------------------
const height = 440;
const padLeft = 56;
const padRight = 18;
const padTop = 28;
const padBottom = 74;

// The chart grows sideways as freezes accumulate; it does not compress them.
//
// The width used to be a fixed 800 units, so every new snapshot divided the
// same plot into one more column and the analyzer fan inside each column was
// squeezed to fit (see `fannedOffset`'s cap). Seven columns had already pushed
// the fan below its preferred spacing, and the eighth would have been worse.
// Sizing the band from what one column actually has to hold — the whole fan at
// its preferred spacing, plus the margin that keeps neighbouring columns apart
// — makes the geometry stable in the number of snapshots, and the frame's
// `overflow-x` carries whatever no longer fits the content column.
//
// The floor is the band the seven-snapshot chart was published with, so a
// freeze that loses an analyzer cannot make the columns narrower than they
// have already been seen.
const bandMargin = 24;
const preferredSpacing = 13;
const band = Math.max(
  104,
  preferredSpacing * Math.max(cohortSeries.length - 1, 1) + bandMargin,
);
const plotWidth = band * columns.length;
const width = padLeft + plotWidth + padRight;
const plotHeight = height - padTop - padBottom;

/**
 * The CSS floor for the rendered chart, in rem, kept proportional to the SVG's
 * own aspect so a column never renders narrower than about 6rem — roughly what
 * a `v0.7.0` label and its kernel count need side by side. Below this the frame
 * scrolls rather than the columns shrinking.
 */
const minWidthRem = Math.round((columns.length * 6 + 5) * 10) / 10;

const ceiling = Math.max(...allColumns.map((column) => column.population));
const step = 200;
const axisMax = Math.max(step, Math.ceil(ceiling / step) * step);
const ticks: number[] = [];
for (let value = 0; value <= axisMax; value += step) ticks.push(value);

const bandCenter = (index: number) => padLeft + (index + 0.5) * band;
const y = (value: number) => padTop + plotHeight * (1 - value / axisMax);

// A constant per-series horizontal offset: the markers of one column no longer
// collide, and because every point of a series shifts by the same amount the
// shape of the line is untouched.
//
// The spacing is capped so the whole fan always fits inside one band, however
// many analyzers a snapshot carries. With a fixed spacing, adding analyzers
// eventually pushes the outermost series past the plot edge and into the
// neighbouring column — which both clips markers and puts a point visually
// under the wrong snapshot label. The preferred spacings below are the ones
// the four-analyzer snapshots were published with, and the cap only ever
// tightens them, so no previously published layout moves.
const fannedOffset = (index: number, preferred: number) => {
  const spacing =
    cohortSeries.length <= 1
      ? 0
      : Math.min(preferred, (band - bandMargin) / (cohortSeries.length - 1));
  return (index - (cohortSeries.length - 1) / 2) * spacing;
};
const seriesOffset = (index: number) => fannedOffset(index, preferredSpacing);

const columnIndex = new Map(columns.map((column, index) => [column.version, index]));

// ---- Normalized geometry --------------------------------------------------
// The second view divides each analyzer's decisive-correct count by *its own*
// covered population — the assertions in the kernels it actually reported on.
// Inconclusive, unsupported and runner-error outcomes inside those kernels
// stay in the denominator: they are non-answers on cases the analyzer did take
// on, and they cost accuracy. This is deliberately *not* correct÷decided,
// which would let an analyzer that decides almost nothing graph near 100%;
// that ratio appears only as a secondary, labelled figure in tooltips and the
// table.
const percentAxisMax = 100;
const percentStep = 20;
const percentTicks: number[] = [];
for (let value = 0; value <= percentAxisMax; value += percentStep) {
  percentTicks.push(value);
}
const yPercent = (value: number) =>
  padTop + plotHeight * (1 - value / percentAxisMax);
/** Decisive-correct over the analyzer's own covered population. */
const coveredShare = (point: SeriesPoint) =>
  point.covered === 0 ? 0 : (point.correct / point.covered) * 100;
/** Secondary, always labelled: decisive-correct over decisive outcomes only. */
const decidedShare = (point: SeriesPoint) =>
  point.decided === 0 ? null : (point.correct / point.decided) * 100;
const formatPercent = (value: number) => `${value.toFixed(1)}%`;
// The normalized view has no ceiling labels crowding the bands, so the series
// may spread further apart — enough room for a per-point coverage annotation —
// but it is capped to the band just as the absolute view is.
const percentOffset = (index: number) => fannedOffset(index, 30);
// When the fan is tighter than a `k/n` label is wide, those labels are dealt
// out over three rows so neighbours cannot overprint each other.
const percentSpacing =
  cohortSeries.length <= 1 ? 0 : Math.abs(percentOffset(1) - percentOffset(0));
const labelRows = percentSpacing >= 26 ? 1 : 3;
const labelRow = (index: number) => index % labelRows;
/** Marker area grows with the share of the snapshot's kernels covered. */
const markerRadius = (point: SeriesPoint, columnKernels: number) =>
  3 + 4 * (columnKernels === 0 ? 0 : point.kernels / columnKernels);
const columnKernelsOf = (version: string) =>
  columns[columnIndex.get(version) ?? 0]!.kernels;

// The step line for the benchmark's own population: flat across each snapshot's
// band, jumping between them, so the growth of the denominator is a shape
// rather than a footnote.
const ceilingPath = columns
  .map((column, index) => {
    const left = padLeft + index * band;
    const right = left + band;
    const top = y(column.population);
    return `${index === 0 ? 'M' : 'L'} ${left.toFixed(1)} ${top.toFixed(1)} L ${right.toFixed(1)} ${top.toFixed(1)}`;
  })
  .join(' ');

/** Contiguous runs, so a snapshot an analyzer skipped breaks the line. */
function runs(points: SeriesPoint[]): SeriesPoint[][] {
  const out: SeriesPoint[][] = [];
  let current: SeriesPoint[] = [];
  let previous = -2;
  for (const point of points) {
    const index = columnIndex.get(point.version) ?? -1;
    if (index !== previous + 1 && current.length > 0) {
      out.push(current);
      current = [];
    }
    current.push(point);
    previous = index;
  }
  if (current.length > 0) out.push(current);
  return out;
}

function linePath(points: SeriesPoint[], offset: number): string {
  return points
    .map((point, index) => {
      const x = bandCenter(columnIndex.get(point.version) ?? 0) + offset;
      return `${index === 0 ? 'M' : 'L'} ${x.toFixed(1)} ${y(point.correct).toFixed(1)}`;
    })
    .join(' ');
}

function percentLinePath(points: SeriesPoint[], offset: number): string {
  return points
    .map((point, index) => {
      const x = bandCenter(columnIndex.get(point.version) ?? 0) + offset;
      return `${index === 0 ? 'M' : 'L'} ${x.toFixed(1)} ${yPercent(
        coveredShare(point),
      ).toFixed(1)}`;
    })
    .join(' ');
}

const evidenceHref = (slug: string) =>
  `/snapshots/${slug}/evidence/`;

const rows = columns.flatMap((column) =>
  cohortSeries
    .map((entry) => ({
      column,
      entry,
      point: entry.points.find((point) => point.version === column.version),
    }))
    .filter(
      (row): row is { column: SnapshotColumn; entry: Series; point: SeriesPoint } =>
        row.point !== undefined,
    ),
);

const first = columns[0]!;
const last = columns.at(-1)!;

---

{heading && <h2 id="evolution">How the benchmark and its analyzers evolved</h2>}

<h3>{cohortLabel}</h3>

<p class="chart-note">
  {heading ? (
    <>
      One line per analyzer across every freeze. The vertical axis counts
      decisive-correct assertions; the grey step is the full benchmark core,
      which grew from {first.population} assertions in {first.version} to{' '}
      {last.population} in {last.version}. Nothing is pooled with other result
      profiles or turned into a combined score.
    </>
  ) : (
    <>
      {cohortDescription}, separated because breadth and specialization are not
      directly comparable. Uses the same axes as the generalist panel.
    </>
  )}
</p>

<div class="evolution">
  <input
    class="view-radio absolute-radio"
    type="radio"
    name={`evolution-view-${scope}`}
    id={`evolution-view-absolute-${scope}`}
    checked
  />
  <input
    class="view-radio normalized-radio"
    type="radio"
    name={`evolution-view-${scope}`}
    id={`evolution-view-normalized-${scope}`}
  />
  <input
    class="view-radio table-radio"
    type="radio"
    name={`evolution-view-${scope}`}
    id={`evolution-view-table-${scope}`}
  />
  <div class="view-toggle" role="group" aria-label="Evolution chart view">
    <label class="absolute-label" for={`evolution-view-absolute-${scope}`}>Absolute counts</label>
    <label class="normalized-label" for={`evolution-view-normalized-${scope}`}>Accuracy on covered kernels</label>
    <label class="table-label" for={`evolution-view-table-${scope}`}>Data table</label>
  </div>

<div class="chart-frame view-absolute" style={`--evolution-min-width: ${minWidthRem}rem`}>
  <svg
    class="evolution-chart"
    viewBox={`0 0 ${width} ${height}`}
    role="img"
    aria-labelledby="evolution-chart-title evolution-chart-desc"
  >
    <title id="evolution-chart-title">
      Decisive-correct assertions per analyzer across DataFlowBench snapshots
    </title>
    <desc id="evolution-chart-desc">
      A stepped grey line shows each snapshot's total benchmark-controlled core
      population, growing from {first.population} assertions in {first.version}
      to {last.population} in {last.version}. Beneath it, one line per analyzer
      plots that analyzer's decisive-correct count, with a faint stub reaching
      that analyzer's own covered population. Every marker also carries its
      exact figures in a tooltip, and the toggle above this chart has a Data
      table view that lists every value as text.
    </desc>

    {ticks.map((tick) => (
      <>
        <line
          class="grid"
          x1={padLeft}
          x2={width - padRight}
          y1={y(tick)}
          y2={y(tick)}
        />
        <text class="tick" x={padLeft - 10} y={y(tick) + 4} text-anchor="end">
          {tick}
        </text>
      </>
    ))}

    <line
      class="axis"
      x1={padLeft}
      x2={width - padRight}
      y1={y(0)}
      y2={y(0)}
    />

    <path class="ceiling" d={ceilingPath} />
    {columns.map((column, index) => (
      <text
        class="ceiling-label"
        x={bandCenter(index)}
        y={y(column.population) - 9}
        text-anchor="middle"
      >
        {column.population}
      </text>
    ))}

    {cohortSeries.map((entry, entryIndex) => {
      const offset = seriesOffset(entryIndex);
      return (
        <g class:list={['series', entry.colorClass]}>
          {entry.points.map((point) => {
            const x = bandCenter(columnIndex.get(point.version) ?? 0) + offset;
            return (
              <>
                <line
                  class="uncorrect"
                  x1={x}
                  x2={x}
                  y1={y(point.covered)}
                  y2={y(point.correct)}
                />
                <line
                  class="covered-cap"
                  x1={x - 5}
                  x2={x + 5}
                  y1={y(point.covered)}
                  y2={y(point.covered)}
                />
              </>
            );
          })}
          {runs(entry.points).map((run) => (
            <path class="line" d={linePath(run, offset)} />
          ))}
          {entry.points.map((point) => {
            const x = bandCenter(columnIndex.get(point.version) ?? 0) + offset;
            return (
              <circle class="dot" cx={x} cy={y(point.correct)} r="4.5">
                <title>
                  {entry.name} · {point.version} · {point.correct} decisive-correct
                  of {point.covered} covered ({point.kernels} of{' '}
                  {columnKernelsOf(point.version)} kernels) ={' '}
                  {formatPercent(coveredShare(point))}; secondary,
                  correct ÷ decided = {point.correct} of {point.decided}
                </title>
              </circle>
            );
          })}
        </g>
      );
    })}

    {columns.map((column, index) => (
      <a href={evidenceHref(column.slug)}>
        <text
          class="x-label"
          x={bandCenter(index)}
          y={height - padBottom + 24}
          text-anchor="middle"
        >
          {column.version}
        </text>
        <text
          class="x-sub"
          x={bandCenter(index)}
          y={height - padBottom + 41}
          text-anchor="middle"
        >
          {column.kernels} {column.kernels === 1 ? 'kernel' : 'kernels'}
        </text>
      </a>
    ))}

    <text class="axis-title" x="2" y={padTop - 12} text-anchor="start">
      assertions
    </text>
  </svg>
</div>

<div class="chart-frame view-normalized" style={`--evolution-min-width: ${minWidthRem}rem`}>
  <svg
    class="evolution-chart"
    viewBox={`0 0 ${width} ${height}`}
    role="img"
    aria-labelledby="evolution-percent-title evolution-percent-desc"
  >
    <title id="evolution-percent-title">
      Decisive-correct share of each analyzer's own covered population across
      DataFlowBench snapshots
    </title>
    <desc id="evolution-percent-desc">
      One line per analyzer on a nought to one hundred percent axis. Each point
      is that analyzer's decisive-correct count divided by the assertions in the
      kernels it covers, with inconclusive and unsupported outcomes left in the
      denominator. Marker size grows with the share of the snapshot's kernels
      the analyzer covers, and every point is annotated with that kernel count.
      Every marker also carries its exact figures in a tooltip, and the toggle
      above this chart has a Data table view that lists every value as text,
      including the denominator each percentage is over.
    </desc>

    {percentTicks.map((tick) => (
      <>
        <line
          class="grid"
          x1={padLeft}
          x2={width - padRight}
          y1={yPercent(tick)}
          y2={yPercent(tick)}
        />
        <text
          class="tick"
          x={padLeft - 10}
          y={yPercent(tick) + 4}
          text-anchor="end"
        >
          {tick}%
        </text>
      </>
    ))}

    <line
      class="axis"
      x1={padLeft}
      x2={width - padRight}
      y1={yPercent(0)}
      y2={yPercent(0)}
    />

    {cohortSeries.map((entry, entryIndex) => {
      const offset = percentOffset(entryIndex);
      return (
        <g class:list={['series', entry.colorClass]}>
          {entry.points.map((point) => {
            const x = bandCenter(columnIndex.get(point.version) ?? 0) + offset;
            return (
              <line
                class="uncorrect"
                x1={x}
                x2={x}
                y1={yPercent(percentAxisMax)}
                y2={yPercent(coveredShare(point))}
              />
            );
          })}
          {runs(entry.points).map((run) => (
            <path class="line" d={percentLinePath(run, offset)} />
          ))}
          {entry.points.map((point) => {
            const x = bandCenter(columnIndex.get(point.version) ?? 0) + offset;
            const kernels = columnKernelsOf(point.version);
            const radius = markerRadius(point, kernels);
            return (
              <>
                <circle
                  class="dot"
                  cx={x}
                  cy={yPercent(coveredShare(point))}
                  r={radius.toFixed(2)}
                >
                  <title>
                    {entry.name} · {point.version} ·{' '}
                    {formatPercent(coveredShare(point))} — {point.correct} of{' '}
                    {point.covered} covered ({point.kernels} of {kernels}{' '}
                    {kernels === 1 ? 'kernel' : 'kernels'}); secondary, correct ÷
                    decided = {point.correct} of {point.decided}
                  </title>
                </circle>
                <text
                  class="coverage-note"
                  x={x}
                  y={
                    yPercent(coveredShare(point)) +
                    radius +
                    12 +
                    labelRow(entryIndex) * 11
                  }
                  text-anchor="middle"
                >
                  {point.kernels}/{kernels}
                </text>
              </>
            );
          })}
        </g>
      );
    })}

    {columns.map((column, index) => (
      <a href={evidenceHref(column.slug)}>
        <text
          class="x-label"
          x={bandCenter(index)}
          y={height - padBottom + 24}
          text-anchor="middle"
        >
          {column.version}
        </text>
        <text
          class="x-sub"
          x={bandCenter(index)}
          y={height - padBottom + 41}
          text-anchor="middle"
        >
          {column.kernels} {column.kernels === 1 ? 'kernel' : 'kernels'}
        </text>
      </a>
    ))}

    <text class="axis-title" x="2" y={padTop - 12} text-anchor="start">
      % of its covered population
    </text>
  </svg>
</div>

<ul class="chart-legend view-absolute">
  {cohortSeries.map((entry) => (
    <li class:list={[entry.colorClass]}>
      <span class="swatch" aria-hidden="true"></span>
      {entry.name} · decisive-correct
    </li>
  ))}
  <li class="ceiling-key">
    <span class="swatch" aria-hidden="true"></span>
    benchmark core population (the denominator)
  </li>
  <li class="stub-key">
    <span class="swatch" aria-hidden="true"></span>
    remainder of that analyzer's own covered population
  </li>
</ul>

<ul class="chart-legend view-normalized">
  {cohortSeries.map((entry) => (
    <li class:list={[entry.colorClass]}>
      <span class="swatch" aria-hidden="true"></span>
      {entry.name} · decisive-correct ÷ its covered population
    </li>
  ))}
  <li class="size-key">
    <span class="swatch" aria-hidden="true"></span>
    marker size and the <code>k/n</code> label under it: kernels covered of the
    snapshot's kernels
  </li>
</ul>

<p class="caption chart-key">
  {heading ? (
    <>
      Marker: decisive-correct. Cap or stub: that analyzer's covered population.
      Grey step: the full core population. The covered-kernel view keeps
      non-answers in its denominator and shows coverage as <code>k/n</code>;
      missing runs are absent, never zero. Exact figures are in the table.
    </>
  ) : (
    <>
      Same scales and encoding as the generalists. The covered-kernel view keeps
      specialist scope visible as <code>k/n</code>; exact figures are in the table.
    </>
  )}
</p>

<div class="table-scroll view-table">
  <table>
    <thead>
      <tr>
        <th>Snapshot</th>
        <th>Analyzer</th>
        <th>Decisive-correct</th>
        <th>Decided</th>
        <th>Coverage outcomes</th>
        <th>Its covered population</th>
        <th>Correct ÷ its covered population</th>
        <th>Benchmark core population</th>
        <th>Secondary: correct ÷ decided</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <td>
            <a href={evidenceHref(row.column.slug)}>{row.column.version}</a>
          </td>
          <td>
            <span
              class:list={['vendor-dot', row.entry.colorClass]}
              aria-hidden="true"></span>
            {row.entry.name}
          </td>
          <td>{row.point.correct}</td>
          <td>{row.point.decided}</td>
          <td>{row.point.incomplete}</td>
          <td>
            {row.point.covered}
            <span class="muted">
              {`(${row.point.kernels} of ${row.column.kernels} ${
                row.column.kernels === 1 ? 'kernel' : 'kernels'
              })`}
            </span>
          </td>
          <td>
            {formatPercent(coveredShare(row.point))}
            <span class="muted">
              {`(${row.point.correct} of ${row.point.covered} covered, ${
                row.point.kernels
              } of ${row.column.kernels} ${
                row.column.kernels === 1 ? 'kernel' : 'kernels'
              })`}
            </span>
          </td>
          <td>{row.column.population}</td>
          <td class="muted">
            {(() => {
              const share = decidedShare(row.point);
              return share === null
                ? 'n/a'
                : `${formatPercent(share)} (${row.point.correct} of ${
                    row.point.decided
                  } decided)`;
            })()}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<p class="caption view-table">
  The exact values behind both chart views, one row per analyzer and snapshot.
</p>
</div>

<style>
  /* The view toggle is a plain radio group: no JavaScript, keyboard-operable
     by default (Tab into the group, arrows between options), and it degrades
     to two labelled radios if the stylesheet never arrives. The radios sit as
     direct children of `.evolution` so `:checked ~ …` can reach every element
