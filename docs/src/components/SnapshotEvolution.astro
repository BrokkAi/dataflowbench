---
// Cross-snapshot evolution of the benchmark-controlled kernel population.
//
// Every number here is derived at build time from the archived `results.json`
// of each freeze (and the current one), through the *same* no-pooling
// population filter the landing cards use — `coreKernelPopulations`. Nothing
// on this page is hand-entered, and nothing is pooled: benchmark-controlled
// kernels only, `core` tiers only, one series per analyzer, no combined score.
import {
  snapshots,
  coreKernelPopulations,
  vendorColorClass,
  vendorName,
  vendorOrder,
} from '../data/snapshots';

interface SeriesPoint {
  version: string;
  slug: string;
  /** Decisive-correct: true positives plus true negatives. */
  correct: number;
  /** Decisive outcomes of any kind: TP + TN + FP + FN. */
  decided: number;
  /** Decisive but wrong: FP + FN. */
  wrong: number;
  /** Coverage outcomes — never plotted as negatives, never as zeroes. */
  incomplete: number;
  /** Assertions in the kernels this analyzer actually reported on. */
  covered: number;
  /** Kernels this analyzer covers, of the snapshot's kernels. */
  kernels: number;
}

interface Series {
  tool: string;
  name: string;
  colorClass: string;
  points: SeriesPoint[];
}

interface SnapshotColumn {
  version: string;
  slug: string;
  /** The snapshot's whole benchmark-controlled core population. */
  population: number;
  kernels: number;
  languages: number;
}

// Oldest first: the registry is newest-first for the sidebar's sake.
const timeline = [...snapshots].reverse();

const columns: SnapshotColumn[] = [];
const byTool = new Map<string, SeriesPoint[]>();

for (const snapshot of timeline) {
  const populations = coreKernelPopulations(snapshot.results);
  const population = populations.reduce((sum, entry) => sum + entry.cases, 0);
  columns.push({
    version: snapshot.version,
    slug: snapshot.slug,
    population,
    kernels: populations.length,
    languages: new Set(populations.map((entry) => entry.language)).size,
  });

  const totals = new Map<string, SeriesPoint>();
  for (const entry of populations) {
    for (const [tool, coverage] of entry.entries) {
      let point = totals.get(tool);
      if (!point) {
        point = {
          version: snapshot.version,
          slug: snapshot.slug,
          correct: 0,
          decided: 0,
          wrong: 0,
          incomplete: 0,
          covered: 0,
          kernels: 0,
        };
        totals.set(tool, point);
      }
      for (const result of coverage.tier.cases) {
        switch (result.classification) {
          case 'true-positive':
          case 'true-negative':
            point.correct += 1;
            point.decided += 1;
            break;
          case 'false-positive':
          case 'false-negative':
            point.wrong += 1;
            point.decided += 1;
            break;
          default:
            // inconclusive, unsupported, runner-error: capability coverage.
            point.incomplete += 1;
        }
      }
      point.covered += entry.cases;
      point.kernels += 1;
    }
  }
  // An analyzer absent from a snapshot gets no entry at all — no zero point,
  // and the line below simply does not pass through this column.
  for (const [tool, point] of totals) {
    const points = byTool.get(tool) ?? [];
    points.push(point);
    byTool.set(tool, points);
  }
}

const series: Series[] = [...byTool.entries()]
  .map(([tool, points]) => ({
    tool,
    name: vendorName(tool),
    colorClass: vendorColorClass(tool),
    points,
  }))
  .sort(
    (left, right) =>
      vendorOrder(left.tool) - vendorOrder(right.tool) ||
      left.name.localeCompare(right.name),
  );

// ---- Geometry -------------------------------------------------------------
const width = 800;
const height = 440;
const padLeft = 56;
const padRight = 18;
const padTop = 28;
const padBottom = 74;
const plotWidth = width - padLeft - padRight;
const plotHeight = height - padTop - padBottom;
const band = plotWidth / columns.length;

const ceiling = Math.max(...columns.map((column) => column.population));
const step = 200;
const axisMax = Math.max(step, Math.ceil(ceiling / step) * step);
const ticks: number[] = [];
for (let value = 0; value <= axisMax; value += step) ticks.push(value);

const bandCenter = (index: number) => padLeft + (index + 0.5) * band;
const y = (value: number) => padTop + plotHeight * (1 - value / axisMax);
// A constant per-series horizontal offset: the markers of one column no longer
// collide, and because every point of a series shifts by the same amount the
// shape of the line is untouched.
const seriesOffset = (index: number) =>
  (index - (series.length - 1) / 2) * 13;

const columnIndex = new Map(columns.map((column, index) => [column.version, index]));

// ---- Normalized geometry --------------------------------------------------
// The second view divides each analyzer's decisive-correct count by *its own*
// covered population — the assertions in the kernels it actually reported on.
// Inconclusive, unsupported and runner-error outcomes inside those kernels
// stay in the denominator: they are non-answers on cases the analyzer did take
// on, and they cost accuracy. This is deliberately *not* correct÷decided,
// which would let an analyzer that decides almost nothing graph near 100%;
// that ratio appears only as a secondary, labelled figure in tooltips and the
// table.
const percentAxisMax = 100;
const percentStep = 20;
const percentTicks: number[] = [];
for (let value = 0; value <= percentAxisMax; value += percentStep) {
  percentTicks.push(value);
}
const yPercent = (value: number) =>
  padTop + plotHeight * (1 - value / percentAxisMax);
/** Decisive-correct over the analyzer's own covered population. */
const coveredShare = (point: SeriesPoint) =>
  point.covered === 0 ? 0 : (point.correct / point.covered) * 100;
/** Secondary, always labelled: decisive-correct over decisive outcomes only. */
const decidedShare = (point: SeriesPoint) =>
  point.decided === 0 ? null : (point.correct / point.decided) * 100;
const formatPercent = (value: number) => `${value.toFixed(1)}%`;
// The normalized view has no ceiling labels crowding the bands, so the series
// can spread further apart — enough room for a per-point coverage annotation.
const percentOffset = (index: number) =>
  (index - (series.length - 1) / 2) * 30;
/** Marker area grows with the share of the snapshot's kernels covered. */
const markerRadius = (point: SeriesPoint, columnKernels: number) =>
  3 + 4 * (columnKernels === 0 ? 0 : point.kernels / columnKernels);
const columnKernelsOf = (version: string) =>
  columns[columnIndex.get(version) ?? 0]!.kernels;

// The step line for the benchmark's own population: flat across each snapshot's
// band, jumping between them, so the growth of the denominator is a shape
// rather than a footnote.
const ceilingPath = columns
  .map((column, index) => {
    const left = padLeft + index * band;
    const right = left + band;
    const top = y(column.population);
    return `${index === 0 ? 'M' : 'L'} ${left.toFixed(1)} ${top.toFixed(1)} L ${right.toFixed(1)} ${top.toFixed(1)}`;
  })
  .join(' ');

/** Contiguous runs, so a snapshot an analyzer skipped breaks the line. */
function runs(points: SeriesPoint[]): SeriesPoint[][] {
  const out: SeriesPoint[][] = [];
  let current: SeriesPoint[] = [];
  let previous = -2;
  for (const point of points) {
    const index = columnIndex.get(point.version) ?? -1;
    if (index !== previous + 1 && current.length > 0) {
      out.push(current);
      current = [];
    }
    current.push(point);
    previous = index;
  }
  if (current.length > 0) out.push(current);
  return out;
}

function linePath(points: SeriesPoint[], offset: number): string {
  return points
    .map((point, index) => {
      const x = bandCenter(columnIndex.get(point.version) ?? 0) + offset;
      return `${index === 0 ? 'M' : 'L'} ${x.toFixed(1)} ${y(point.correct).toFixed(1)}`;
    })
    .join(' ');
}

function percentLinePath(points: SeriesPoint[], offset: number): string {
  return points
    .map((point, index) => {
      const x = bandCenter(columnIndex.get(point.version) ?? 0) + offset;
      return `${index === 0 ? 'M' : 'L'} ${x.toFixed(1)} ${yPercent(
        coveredShare(point),
      ).toFixed(1)}`;
    })
    .join(' ');
}

const evidenceHref = (slug: string) =>
  `/dataflowbench/snapshots/${slug}/evidence/`;

const rows = columns.flatMap((column) =>
  series
    .map((entry) => ({
      column,
      entry,
      point: entry.points.find((point) => point.version === column.version),
    }))
    .filter(
      (row): row is { column: SnapshotColumn; entry: Series; point: SeriesPoint } =>
        row.point !== undefined,
    ),
);

const first = columns[0]!;
const last = columns.at(-1)!;

// The snapshot that expanded the population the most: the freeze where a
// falling share is the benchmark moving, not an analyzer regressing.
const biggestJump = columns
  .map((column, index) => ({
    column,
    previous: columns[index - 1],
    growth: column.population - (columns[index - 1]?.population ?? 0),
  }))
  .filter((entry) => entry.previous !== undefined)
  .sort((left, right) => right.growth - left.growth)[0]!;
---

<h2 id="evolution">How the benchmark and its analyzers evolved</h2>

<p>
  One series per analyzer, across every published freeze. The vertical axis
  counts <strong>decisive-correct assertions</strong> — true positives plus
  true negatives — on the <code>benchmark-controlled</code> kernel population,
  the same no-pooling population the cards at the top of this page read. The
  grey step is the benchmark itself: the total core population of that
  snapshot, which grew from {first.population} assertions in
  {first.version} to {last.population} in {last.version}. Nothing here is
  pooled with the modeling matrix or the tool-native probes, and there is no
  combined cross-analyzer score: read each line on its own. The second view
  divides each analyzer's decisive-correct count by the population it actually
  covers, so a narrow language footprint no longer reads as a weak result.
</p>

<div class="evolution">
  <input
    class="view-radio"
    type="radio"
    name="evolution-view"
    id="evolution-view-absolute"
    checked
  />
  <input
    class="view-radio"
    type="radio"
    name="evolution-view"
    id="evolution-view-normalized"
  />
  <div class="view-toggle" role="group" aria-label="Evolution chart view">
    <label for="evolution-view-absolute">Absolute counts</label>
    <label for="evolution-view-normalized">Accuracy on covered kernels</label>
  </div>

<div class="chart-frame view-absolute">
  <svg
    class="evolution-chart"
    viewBox={`0 0 ${width} ${height}`}
    role="img"
    aria-labelledby="evolution-chart-title evolution-chart-desc"
  >
    <title id="evolution-chart-title">
      Decisive-correct assertions per analyzer across DataFlowBench snapshots
    </title>
    <desc id="evolution-chart-desc">
      A stepped grey line shows each snapshot's total benchmark-controlled core
      population. Beneath it, one line per analyzer plots that analyzer's
      decisive-correct count. The table that follows carries every value.
    </desc>

    {ticks.map((tick) => (
      <>
        <line
          class="grid"
          x1={padLeft}
          x2={width - padRight}
          y1={y(tick)}
          y2={y(tick)}
        />
        <text class="tick" x={padLeft - 10} y={y(tick) + 4} text-anchor="end">
          {tick}
        </text>
      </>
    ))}

    <line
      class="axis"
      x1={padLeft}
      x2={width - padRight}
      y1={y(0)}
      y2={y(0)}
    />

    <path class="ceiling" d={ceilingPath} />
    {columns.map((column, index) => (
      <text
        class="ceiling-label"
        x={bandCenter(index)}
        y={y(column.population) - 9}
        text-anchor="middle"
      >
        {column.population}
      </text>
    ))}

    {series.map((entry, entryIndex) => {
      const offset = seriesOffset(entryIndex);
      return (
        <g class:list={['series', entry.colorClass]}>
          {entry.points.map((point) => {
            const x = bandCenter(columnIndex.get(point.version) ?? 0) + offset;
            return (
              <>
                <line
                  class="uncorrect"
                  x1={x}
                  x2={x}
                  y1={y(point.covered)}
                  y2={y(point.correct)}
                />
                <line
                  class="covered-cap"
                  x1={x - 5}
                  x2={x + 5}
                  y1={y(point.covered)}
                  y2={y(point.covered)}
                />
              </>
            );
          })}
          {runs(entry.points).map((run) => (
            <path class="line" d={linePath(run, offset)} />
          ))}
          {entry.points.map((point) => {
            const x = bandCenter(columnIndex.get(point.version) ?? 0) + offset;
            return (
              <circle class="dot" cx={x} cy={y(point.correct)} r="4.5">
                <title>
                  {entry.name} · {point.version} · {point.correct} decisive-correct
                  of {point.covered} covered ({point.kernels} of{' '}
                  {columnKernelsOf(point.version)} kernels) ={' '}
                  {formatPercent(coveredShare(point))}; secondary,
                  correct ÷ decided = {point.correct} of {point.decided}
                </title>
              </circle>
            );
          })}
        </g>
      );
    })}

    {columns.map((column, index) => (
      <a href={evidenceHref(column.slug)}>
        <text
          class="x-label"
          x={bandCenter(index)}
          y={height - padBottom + 24}
          text-anchor="middle"
        >
          {column.version}
        </text>
        <text
          class="x-sub"
          x={bandCenter(index)}
          y={height - padBottom + 41}
          text-anchor="middle"
        >
          {column.kernels} {column.kernels === 1 ? 'kernel' : 'kernels'}
        </text>
      </a>
    ))}

    <text class="axis-title" x="2" y={padTop - 12} text-anchor="start">
      assertions
    </text>
  </svg>
</div>

<div class="chart-frame view-normalized">
  <svg
    class="evolution-chart"
    viewBox={`0 0 ${width} ${height}`}
    role="img"
    aria-labelledby="evolution-percent-title evolution-percent-desc"
  >
    <title id="evolution-percent-title">
      Decisive-correct share of each analyzer's own covered population across
      DataFlowBench snapshots
    </title>
    <desc id="evolution-percent-desc">
      One line per analyzer on a nought to one hundred percent axis. Each point
      is that analyzer's decisive-correct count divided by the assertions in the
      kernels it covers, with inconclusive and unsupported outcomes left in the
      denominator. Marker size grows with the share of the snapshot's kernels
      the analyzer covers, and every point is annotated with that kernel count.
      The table that follows carries every value.
    </desc>

    {percentTicks.map((tick) => (
      <>
        <line
          class="grid"
          x1={padLeft}
          x2={width - padRight}
          y1={yPercent(tick)}
          y2={yPercent(tick)}
        />
        <text
          class="tick"
          x={padLeft - 10}
          y={yPercent(tick) + 4}
          text-anchor="end"
        >
          {tick}%
        </text>
      </>
    ))}

    <line
      class="axis"
      x1={padLeft}
      x2={width - padRight}
      y1={yPercent(0)}
      y2={yPercent(0)}
    />

    {series.map((entry, entryIndex) => {
      const offset = percentOffset(entryIndex);
      return (
        <g class:list={['series', entry.colorClass]}>
          {entry.points.map((point) => {
            const x = bandCenter(columnIndex.get(point.version) ?? 0) + offset;
            return (
              <line
                class="uncorrect"
                x1={x}
                x2={x}
                y1={yPercent(percentAxisMax)}
                y2={yPercent(coveredShare(point))}
              />
            );
          })}
          {runs(entry.points).map((run) => (
            <path class="line" d={percentLinePath(run, offset)} />
          ))}
          {entry.points.map((point) => {
            const x = bandCenter(columnIndex.get(point.version) ?? 0) + offset;
            const kernels = columnKernelsOf(point.version);
            const radius = markerRadius(point, kernels);
            return (
              <>
                <circle
                  class="dot"
                  cx={x}
                  cy={yPercent(coveredShare(point))}
                  r={radius.toFixed(2)}
                >
                  <title>
                    {entry.name} · {point.version} ·{' '}
                    {formatPercent(coveredShare(point))} — {point.correct} of{' '}
                    {point.covered} covered ({point.kernels} of {kernels}{' '}
                    {kernels === 1 ? 'kernel' : 'kernels'}); secondary, correct ÷
                    decided = {point.correct} of {point.decided}
                  </title>
                </circle>
                <text
                  class="coverage-note"
                  x={x}
                  y={yPercent(coveredShare(point)) + radius + 12}
                  text-anchor="middle"
                >
                  {point.kernels}/{kernels}
                </text>
              </>
            );
          })}
        </g>
      );
    })}

    {columns.map((column, index) => (
      <a href={evidenceHref(column.slug)}>
        <text
          class="x-label"
          x={bandCenter(index)}
          y={height - padBottom + 24}
          text-anchor="middle"
        >
          {column.version}
        </text>
        <text
          class="x-sub"
          x={bandCenter(index)}
          y={height - padBottom + 41}
          text-anchor="middle"
        >
          {column.kernels} {column.kernels === 1 ? 'kernel' : 'kernels'}
        </text>
      </a>
    ))}

    <text class="axis-title" x="2" y={padTop - 12} text-anchor="start">
      % of its covered population
    </text>
  </svg>
</div>

<ul class="chart-legend view-absolute">
  {series.map((entry) => (
    <li class:list={[entry.colorClass]}>
      <span class="swatch" aria-hidden="true"></span>
      {entry.name} · decisive-correct
    </li>
  ))}
  <li class="ceiling-key">
    <span class="swatch" aria-hidden="true"></span>
    benchmark core population (the denominator)
  </li>
  <li class="stub-key">
    <span class="swatch" aria-hidden="true"></span>
    remainder of that analyzer's own covered population
  </li>
</ul>

<ul class="chart-legend view-normalized">
  {series.map((entry) => (
    <li class:list={[entry.colorClass]}>
      <span class="swatch" aria-hidden="true"></span>
      {entry.name} · decisive-correct ÷ its covered population
    </li>
  ))}
  <li class="size-key">
    <span class="swatch" aria-hidden="true"></span>
    marker size and the <code>k/n</code> label under it: kernels covered of the
    snapshot's kernels
  </li>
</ul>

<p class="caption view-note">
  <strong>Absolute counts</strong> plot progress against the whole growing
  benchmark: the marker is the analyzer's decisive-correct count and the grey
  step is the entire core population of that snapshot, so an analyzer that
  supports only part of the benchmark sits far below the step by construction.
  <strong>Accuracy on covered kernels</strong> instead divides each analyzer's
  decisive-correct count by <em>its own</em> covered population — the assertions
  in the kernels it reported on at all — so it answers how well a tool does on
  the slice it supports. Coverage is stated beside every number in that view:
  the marker grows with the share of the snapshot's kernels covered, each point
  carries its <code>k/n</code> kernel count, and the table below spells out the
  denominator, so 78% over 6 kernels is never mistaken for 78% over 13.
  Inconclusive and unsupported outcomes <em>inside</em> covered kernels stay in
  the denominator — they are non-answers on cases the analyzer took on. The
  narrower correct ÷ decided ratio is reported only as a secondary figure, in
  the tooltips and the last table column.
</p>

<p class="caption view-absolute">
  Each marker sits at the analyzer's decisive-correct count. The faint stub
  above it reaches that analyzer's <em>own</em> covered population — the
  assertions it reported on — so the part of the stub above the marker is
  wrong answers plus coverage outcomes, and the remaining gap up to the grey
  step is kernels it does not cover at all. A snapshot without a marker is a
  snapshot the analyzer was not run in: Joern first appears in
  {series.find((entry) => entry.tool === 'joern')?.points[0]?.version ?? 'n/a'},
  Semgrep CE in
  {series.find((entry) => entry.tool === 'semgrep')?.points[0]?.version ?? 'n/a'}.
  Absence is never drawn as a zero and never interpolated across.
  <code>inconclusive</code>, <code>unsupported</code> and
  <code>runner-error</code> are capability coverage: excluded from
  correctness, never converted into wrong answers. Every snapshot label links
  to that freeze's per-case evidence.
</p>

<p class="caption view-normalized">
  Each marker sits at the analyzer's decisive-correct share of its own covered
  population; the faint stub above it runs to 100%, which is that same covered
  population, so the stub is wrong answers plus coverage outcomes inside the
  kernels it did report on. A snapshot without a marker is a snapshot the
  analyzer was not run in: Joern first appears in
  {series.find((entry) => entry.tool === 'joern')?.points[0]?.version ?? 'n/a'},
  Semgrep CE in
  {series.find((entry) => entry.tool === 'semgrep')?.points[0]?.version ?? 'n/a'}.
  Absence is never drawn as a zero and never interpolated across. Percentages
  from different snapshots are not the same exam, and percentages from
  different analyzers in the same snapshot are only the same exam when their
  <code>k/n</code> kernel counts match. Every snapshot label links to that
  freeze's per-case evidence.
</p>
</div>

<div class="table-scroll">
  <table>
    <thead>
      <tr>
        <th>Snapshot</th>
        <th>Analyzer</th>
        <th>Decisive-correct</th>
        <th>Decided</th>
        <th>Coverage outcomes</th>
        <th>Its covered population</th>
        <th>Correct ÷ its covered population</th>
        <th>Benchmark core population</th>
        <th>Secondary: correct ÷ decided</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <td>
            <a href={evidenceHref(row.column.slug)}>{row.column.version}</a>
          </td>
          <td>
            <span
              class:list={['vendor-dot', row.entry.colorClass]}
              aria-hidden="true"></span>
            {row.entry.name}
          </td>
          <td>{row.point.correct}</td>
          <td>{row.point.decided}</td>
          <td>{row.point.incomplete}</td>
          <td>
            {row.point.covered}
            <span class="muted">
              {`(${row.point.kernels} of ${row.column.kernels} ${
                row.column.kernels === 1 ? 'kernel' : 'kernels'
              })`}
            </span>
          </td>
          <td>
            {formatPercent(coveredShare(row.point))}
            <span class="muted">
              {`(${row.point.correct} of ${row.point.covered} covered, ${
                row.point.kernels
              } of ${row.column.kernels} ${
                row.column.kernels === 1 ? 'kernel' : 'kernels'
              })`}
            </span>
          </td>
          <td>{row.column.population}</td>
          <td class="muted">
            {(() => {
              const share = decidedShare(row.point);
              return share === null
                ? 'n/a'
                : `${formatPercent(share)} (${row.point.correct} of ${
                    row.point.decided
                  } decided)`;
            })()}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<p>
  Read the shape, not a ranking. Two different things move a line: an analyzer
  getting better, and the benchmark getting harder. The largest expansion so
  far is <strong>{biggestJump.column.version}</strong>, which took the core
  population from {biggestJump.previous!.population} to
  {biggestJump.column.population} assertions — every analyzer's share of the
  population fell there without any of them changing. Because the denominator
  is drawn alongside the counts, saturation and expansion stay
  distinguishable, and no two snapshots' fractions are ever compared as if
  they were the same exam.
</p>

<style>
  /* The view toggle is a plain radio group: no JavaScript, keyboard-operable
     by default (Tab into the group, arrows between options), and it degrades
     to two labelled radios if the stylesheet never arrives. The radios sit as
     direct children of `.evolution` so `:checked ~ …` can reach every element
     that belongs to one view or the other. */
  .evolution {
    position: relative;
  }
  .view-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .view-toggle {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0 0 0.75rem;
    padding: 0.2rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.6rem;
    background: var(--sl-color-bg-sidebar);
  }
  .view-toggle label {
    /* The content area's global sibling rule adds margin-top to successive
       elements; inside the pill row that staggers the labels vertically. */
    margin: 0 !important;
    cursor: pointer;
    border-radius: 0.45rem;
    padding: 0.3rem 0.7rem;
