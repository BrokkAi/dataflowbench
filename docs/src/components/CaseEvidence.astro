---
import {
  evidenceUrl,
  shortDigest,
  type ScoreTier,
  type Snapshot,
} from '../data/snapshots';

interface Props {
  snapshot: Snapshot;
  tier: ScoreTier;
}

const { snapshot, tier } = Astro.props;
---

<div class="table-scroll ds-table">
  <table>
    <thead>
      <tr>
        <th>Template</th>
        <th>Case</th>
        <th>Polarity</th>
        <th>Outcome</th>
        <th>Classification</th>
        <th>Raw evidence</th>
      </tr>
    </thead>
    <tbody>
      {
        tier.cases.map((result) => (
          <tr>
            <td class="template">
              <code>{result.template_id.replace('dfb-template-', '')}</code>
            </td>
            <td class="case">
              <code>{result.case_id}</code>
            </td>
            <td>{result.polarity}</td>
            <td>
              <code>{result.outcome}</code>
            </td>
            <td class="classification">{result.classification}</td>
            <td>
              <a href={evidenceUrl(snapshot, result.raw_evidence.path)}>
                <code>{shortDigest(result.raw_evidence.sha256)}…</code>
              </a>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .table-scroll {
    overflow-x: auto;
  }
  /* Template and case ids wrap at their hyphens, two or three pieces to a
     line; below that the table pans instead of stacking one piece per line.
     A classification such as true-negative is one term. */
  .template {
    min-width: 9rem;
  }
  .case {
    min-width: 11rem;
  }
  .classification {
    white-space: nowrap;
  }
</style>
