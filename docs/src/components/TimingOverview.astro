---
import {
  timingOverviewV092 as overview,
  timingPosition,
  formatTiming,
} from '../data/timing-overview-v092.ts';

function description(row: (typeof overview.summaryRows)[number]): string {
  if (row.status === 'not-planned') {
    return `${row.analyzer} ${row.pin}: no cold groups were planned for this tier.`;
  }
  if (row.status === 'untimed') {
    return `${row.label}: ${row.measuredGroups} captured groups and ${row.reportRows} report rows, with no timed invocations. Timing absence is not zero time.`;
  }
  if (row.status === 'not-measured') {
    return `${row.analyzer} ${row.pin}: Not measured for v0.9.2. ${row.plannedGroups} planned cold groups; runtime blocker: ${row.blocker ?? 'not recorded'}.`;
  }
  const blocker = row.blocker ? ` Some planned groups remain blocked: ${row.blocker}` : '';
  return `${row.label}: ${row.timed} of ${row.reportRows} retained case invocations have timing across ${row.measuredGroups} of ${row.plannedGroups} planned groups; median ${formatTiming(row.median)}, 90th percentile ${formatTiming(row.p90)}, observed range ${formatTiming(row.min)} to ${formatTiming(row.max)}. Descriptive roll-up only; not certified.${blocker}`;
}

function sliceDescription(row: (typeof overview.rows)[number]): string {
  if (row.median === null) {
    return `${row.label}: no timed invocations; ${row.reportRows} captured report rows.`;
  }
  return `${row.label}: ${row.timed} of ${row.reportRows} rows timed; median ${formatTiming(row.median)}, 90th percentile ${formatTiming(row.p90)}, observed range ${formatTiming(row.min)} to ${formatTiming(row.max)}. Uncertified.`;
}

function visibleAuxiliaryPin(pin: string | undefined): string | undefined {
  if (pin?.startsWith('rules ')) return `rules ${pin.slice(6, 14)}…`;
  return pin;
}
---

<section class="timing-overview" data-timing-overview aria-label="Descriptive v0.9.2 timing roll-up">
  <p class="timing-status">
    <strong>Descriptive roll-up of retained invocation records. No timing is certified.</strong>
    {overview.totals.capturedGroups} of {overview.totals.plannedGroups} planned cold groups have invocation records;
    {overview.totals.timedRows.toLocaleString('en-US')} of {overview.totals.reportRows.toLocaleString('en-US')} captured case invocations have a wall-time observation.
    This is the 13 November 2026 capture. Rows follow the frozen v0.9.2 analyzer order and pins.
  </p>
  <p>
    Each analyzer's distribution is computed from its raw per-case observations. It combines mixed languages,
    tiers, populations and profiles, so it is not a matched comparison, performance ranking or certification.
    The six analyzers without retained cold invocations are shown with their recorded runtime blockers.
  </p>

  <div class="timing-controls" data-timing-controls hidden>
    <label>View
      <select data-timing-view aria-label="Timing view">
        <option value="summary" selected>Analyzer summary</option>
        <option value="slices">Slice detail</option>
      </select>
    </label>
    <label>Analyzer
      <select data-timing-analyzer aria-label="Timing analyzer">
        <option value="all">All analyzers</option>
        {overview.analyzers.map((analyzer) => (
          <option value={analyzer.id}>{analyzer.name}</option>
        ))}
      </select>
    </label>
    <label>Tier
      <select data-timing-tier aria-label="Timing tier">
        <option value="all">All tiers</option>
        <option value="kernel">Kernel</option>
        <option value="smoke">Smoke</option>
        <option value="modeling">Modeling</option>
        <option value="native">Native</option>
      </select>
    </label>
  </div>

  <p class="timing-count" data-timing-count role="status" aria-live="polite" aria-atomic="true">
    {overview.summaryRows.length} analyzers · {overview.totals.capturedGroups} / {overview.totals.plannedGroups} groups captured ·
    {overview.totals.timedRows.toLocaleString('en-US')} / {overview.totals.reportRows.toLocaleString('en-US')} case invocations timed
  </p>

  <figure class="timing-figure" aria-describedby="timing-chart-description">
    <figcaption id="timing-chart-description">
      <strong>Cold whole-invocation wall time, including startup.</strong>
      Dot: median. Tick: 90th percentile. Line: observed minimum to maximum. Logarithmic time scale, shared by every row and filter.
    </figcaption>
    <div class="timing-axis" aria-hidden="true">
      <span class="axis-label" data-axis-label>Analyzer · timed / captured · groups captured / planned</span>
      <div class="axis-ticks">
        {overview.axis.ticksSeconds.map((seconds) => (
          <span style={`left:${timingPosition(seconds * 1000)}%`}>{formatTiming(seconds * 1000)}</span>
        ))}
      </div>
      <span class="median-label">Median</span>
    </div>

    <ul class="timing-rows" data-summary-list aria-label="Cold case distributions by analyzer">
      {overview.aggregateRows.map((row) => (
        <li data-timing-row data-view-row="summary" data-analyzer={row.analyzerId} data-tier={row.tier}
          data-timed={row.timed} data-reported={row.reportRows} data-measured-groups={row.measuredGroups}
          data-planned-groups={row.plannedGroups} hidden={row.tier !== 'all'} aria-label={description(row)}>
          <div class="timing-row-label">
            <span>{row.analyzer}</span>
            <small>{row.pin}{row.auxiliaryPin ? ` · ${visibleAuxiliaryPin(row.auxiliaryPin)}` : ''}</small>
            {row.blocker && <small class="timing-blocker">At capture: {row.blocker}</small>}
          </div>
          <div class="timing-plot" aria-hidden="true">
            {row.status === 'measured' && row.min !== null && row.max !== null && row.median !== null && row.p90 !== null ? (
              <>
                <span class="timing-range" style={`left:${timingPosition(row.min)}%;width:${timingPosition(row.max) - timingPosition(row.min)}%`}></span>
                <span class="timing-p90" style={`left:${timingPosition(row.p90)}%`}></span>
                <span class="timing-median" style={`left:${timingPosition(row.median)}%`}></span>
              </>
            ) : row.status === 'not-planned' ? (
              <span class="timing-untimed">No groups planned for this tier</span>
            ) : row.status === 'not-measured' ? (
              <span class="timing-untimed">Not measured for v0.9.2</span>
            ) : <span class="timing-untimed">No timed invocations</span>}
          </div>
          <span class="timing-value" aria-hidden="true">{formatTiming(row.median)}</span>
          <small class="timing-row-count">
            {row.status === 'not-measured'
              ? `0 / ${row.plannedGroups} groups captured`
              : `${row.timed.toLocaleString('en-US')} / ${row.reportRows.toLocaleString('en-US')} timed · ${row.measuredGroups} / ${row.plannedGroups} groups`}
          </small>
        </li>
      ))}
    </ul>

    <ul class="timing-rows" data-slice-list aria-label="Retained cold timing slices" hidden>
      {overview.rows.map((row) => (
        <li data-timing-row data-view-row="slices" data-analyzer={row.analyzerId} data-tier={row.tier}
          data-timed={row.timed} data-reported={row.reportRows} aria-label={sliceDescription(row)}>
          <div class="timing-row-label">
            <span>{row.label}</span>
            <small>{row.timed.toLocaleString('en-US')} / {row.reportRows.toLocaleString('en-US')} timed</small>
          </div>
          <div class="timing-plot" aria-hidden="true">
            {row.min !== null && row.max !== null && row.median !== null && row.p90 !== null ? (
              <>
                <span class="timing-range" style={`left:${timingPosition(row.min)}%;width:${timingPosition(row.max) - timingPosition(row.min)}%`}></span>
                <span class="timing-p90" style={`left:${timingPosition(row.p90)}%`}></span>
                <span class="timing-median" style={`left:${timingPosition(row.median)}%`}></span>
              </>
            ) : <span class="timing-untimed">No timed invocations</span>}
          </div>
          <span class="timing-value" aria-hidden="true">{formatTiming(row.median)}</span>
        </li>
      ))}
    </ul>
    <p class="timing-empty" data-timing-empty hidden>No retained slice records match these filters. This is missing timing coverage, not unsupported analysis.</p>
  </figure>

  <p class="timing-caveat">
    These values summarize different case invocations, not repeated trials or runtime variance. The Bifrost C cold record
    retained a passing initial quiet-gate flag; later cold records retained false flags because no renewed per-group quiet
    checks were made. Contention was observed in Bifrost C and Java cold records, and Bifrost Python overhead only.
    No CPU observation failures were recorded ({overview.totals.cpuObservationFailures}). A24 inter-adapter settling was
    omitted for the overhead measurements. Process-descendant containment remains unproven, and every recorded
    certification flag remains false.
  </p>
  <p class="timing-overhead">
    <strong>Separate invocation-overhead estimates:</strong>
    Bifrost / Python {formatTiming(overview.overhead[0].range_ms.low)}–{formatTiming(overview.overhead[0].range_ms.high)}
    (contention observed); Infer / C {formatTiming(overview.overhead[1].range_ms.low)}–{formatTiming(overview.overhead[1].range_ms.high)}
    (no contention observed). Three repeats each; ranges are upper-bound estimates including analysis of no-flow fixtures,
    not warm marginal cost. Nothing is subtracted from the cold chart.
  </p>
  <p><a href={overview.pageUrl}>Full timing tables, qualification and downloadable evidence</a></p>

  <details class="timing-values">
    <summary>Timing values for all {overview.rows.length} captured slices</summary>
    <p>Rounded for readability. This table always shows the retained per-slice values, regardless of chart filters. A dash means no timing, never zero; full precision is retained in the downloadable evidence.</p>
    <div class="timing-table-scroll" tabindex="0" role="region" aria-label="Cold timing values">
      <table>
        <caption>Uncertified cold-case wall-clock observations</caption>
        <thead><tr><th scope="col">Slice</th><th scope="col">Timed / captured</th><th scope="col">Minimum</th><th scope="col">Median</th><th scope="col">90th percentile</th><th scope="col">Maximum</th></tr></thead>
        <tbody>{overview.rows.map((row) => (
          <tr><th scope="row">{row.label}</th><td>{row.timed.toLocaleString('en-US')} / {row.reportRows.toLocaleString('en-US')}</td><td>{formatTiming(row.min)}</td><td>{formatTiming(row.median)}</td><td>{formatTiming(row.p90)}</td><td>{formatTiming(row.max)}</td></tr>
        ))}</tbody>
      </table>
    </div>
  </details>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-timing-overview]')) {
    const view = root.querySelector<HTMLSelectElement>('[data-timing-view]');
    const analyzer = root.querySelector<HTMLSelectElement>('[data-timing-analyzer]');
    const tier = root.querySelector<HTMLSelectElement>('[data-timing-tier]');
    const controls = root.querySelector<HTMLElement>('[data-timing-controls]');
    const count = root.querySelector<HTMLElement>('[data-timing-count]');
    const empty = root.querySelector<HTMLElement>('[data-timing-empty]');
    const summaryList = root.querySelector<HTMLElement>('[data-summary-list]');
    const sliceList = root.querySelector<HTMLElement>('[data-slice-list]');
    const axisLabel = root.querySelector<HTMLElement>('[data-axis-label]');
    const rows = [...root.querySelectorAll<HTMLElement>('[data-timing-row]')];
    if (!view || !analyzer || !tier || !controls || !count || !empty || !summaryList || !sliceList || !axisLabel) continue;

    const update = () => {
      const activeView = view.value;
      const activeRows = rows.filter((row) => {
        const matchesView = row.dataset.viewRow === activeView;
        const matchesAnalyzer = analyzer.value === 'all' || row.dataset.analyzer === analyzer.value;
        const matchesTier = activeView === 'summary'
          ? row.dataset.tier === tier.value
          : tier.value === 'all' || row.dataset.tier === tier.value;
        row.hidden = !matchesView || !matchesAnalyzer || !matchesTier;
        return !row.hidden;
      });
      const timed = activeRows.reduce((total, row) => total + Number(row.dataset.timed), 0);
      const reported = activeRows.reduce((total, row) => total + Number(row.dataset.reported), 0);
      const measuredGroups = activeRows.reduce((total, row) => total + Number(row.dataset.measuredGroups ?? 0), 0);
      const plannedGroups = activeRows.reduce((total, row) => total + Number(row.dataset.plannedGroups ?? 0), 0);
      const shown = activeRows.length;
      summaryList.hidden = activeView !== 'summary';
      sliceList.hidden = activeView !== 'slices';
      empty.hidden = shown !== 0 || activeView !== 'slices';
      axisLabel.textContent = activeView === 'summary'
        ? 'Analyzer · timed / captured · groups captured / planned'
        : 'Slice · timed / captured';
      count.textContent = activeView === 'summary'
        ? `${shown} ${shown === 1 ? 'analyzer' : 'analyzers'} · ${measuredGroups} / ${plannedGroups} groups captured · ${timed.toLocaleString('en-US')} / ${reported.toLocaleString('en-US')} case invocations timed`
        : `${shown} ${shown === 1 ? 'slice' : 'slices'} · ${timed.toLocaleString('en-US')} / ${reported.toLocaleString('en-US')} case invocations timed`;
    };

    view.addEventListener('change', update);
    analyzer.addEventListener('change', update);
    tier.addEventListener('change', update);
    update();
    controls.hidden = false;
  }
</script>

<style>
  .timing-overview { margin-block: 1.5rem 3rem; color: var(--ds-text); }
  .timing-status strong { display: block; color: var(--ds-accent-text); }
  .timing-status, .timing-caveat, .timing-overhead { color: var(--ds-text-2); }
  .timing-controls { display: flex; flex-wrap: wrap; gap: 1rem; margin-block: 1.75rem .5rem; }
  .timing-controls label { display: grid; gap: .35rem; margin: 0; font-size: .875rem; }
  .timing-controls select { min-height: 44px; min-width: 10rem; margin: 0; padding: .5rem 2rem .5rem .65rem; color: var(--ds-text); background: var(--ds-control); border: 1px solid var(--ds-line-strong); border-radius: 0; font: inherit; }
  .timing-controls select:focus-visible, .timing-table-scroll:focus-visible { outline: 2px solid var(--ds-accent); outline-offset: 3px; }
  .timing-count { margin-block: .75rem 1.5rem; color: var(--ds-text-2); font-size: .875rem; }
  .timing-figure { margin: 0; max-width: 70rem; }
  figcaption { max-width: var(--dfb-measure); margin-bottom: 1.75rem; color: var(--ds-text-2); font-size: .875rem; }
  figcaption strong { display: block; color: var(--ds-text); }
  .timing-axis, .timing-rows li { display: grid; grid-template-columns: minmax(12rem, 15rem) minmax(0, 1fr) 5rem; column-gap: 1rem; align-items: center; }
  .timing-axis { margin-bottom: .5rem; font-size: .75rem; color: var(--ds-text-3); }
  .axis-ticks { position: relative; height: 1.5rem; }
  .axis-ticks span { position: absolute; white-space: nowrap; transform: translateX(-50%); }
  .axis-ticks span:first-child { transform: none; }
  .median-label { text-align: right; }
  .timing-rows { list-style: none; padding: 0; margin: 0; max-width: none; }
  .timing-rows li { min-height: 3.2rem; margin: 0; padding-block: .45rem; }
  .timing-row-label { min-width: 0; font-size: .875rem; line-height: 1.3; }
  .timing-row-label small { display: block; color: var(--ds-text-3); font-size: .75rem; margin-top: .2rem; overflow-wrap: anywhere; }
  .timing-row-label .timing-blocker { color: var(--ds-text-2); }
  .timing-plot { position: relative; min-width: 0; height: 1.5rem; }
  .timing-range { position: absolute; top: calc(50% - 1px); height: 2px; background: var(--ds-text-3); }
  .timing-range::before, .timing-range::after { content: ''; position: absolute; top: -3px; height: 8px; width: 1px; background: var(--ds-text-3); }
  .timing-range::before { left: 0; }
  .timing-range::after { right: 0; }
  .timing-p90 { position: absolute; top: calc(50% - 6px); width: 2px; height: 12px; background: var(--ds-text); transform: translateX(-50%); }
  .timing-median { position: absolute; top: calc(50% - 4px); width: 8px; height: 8px; border-radius: 50%; background: var(--ds-accent-text); transform: translateX(-50%); }
  .timing-value { text-align: right; font-family: Georgia, 'Times New Roman', serif; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .timing-row-count { grid-column: 1 / -1; margin: -.2rem 0 .25rem; color: var(--ds-text-3); font-size: .75rem; }
  .timing-untimed { font-size: .8rem; color: var(--ds-text-3); }
  .timing-caveat, .timing-overhead { margin-top: 1.5rem; font-size: .875rem; }
  .timing-values { margin-top: 1.5rem; }
  .timing-values summary { cursor: pointer; min-height: 44px; padding-block: .6rem; }
  .timing-table-scroll { overflow-x: auto; }
  .timing-values table { width: 100%; font-variant-numeric: tabular-nums; }
  .timing-values td { text-align: right; white-space: nowrap; }
  .timing-values th { text-align: left; }
  .timing-values caption { text-align: left; color: var(--ds-text-2); }
  .timing-overview [hidden] { display: none; }
  @media (max-width: 640px) {
    .timing-controls { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
    .timing-controls label:first-child { grid-column: 1 / -1; }
    .timing-controls select { width: 100%; min-width: 0; }
    .timing-axis { grid-template-columns: minmax(0, 1fr); padding-top: 1rem; }
    .axis-label, .median-label { display: none; }
    .timing-rows li { grid-template-columns: minmax(0, 1fr) auto; column-gap: .75rem; row-gap: .25rem; margin-bottom: .8rem; }
    .timing-row-label { grid-column: 1; grid-row: 1; }
    .timing-value { grid-column: 2; grid-row: 1; font-size: 1rem; }
    .timing-plot { grid-column: 1 / -1; grid-row: 2; }
    .timing-row-count { grid-column: 1 / -1; grid-row: 3; margin: 0; }
    .timing-row-label small { margin-top: .15rem; }
    .timing-untimed { display: block; }
  }
  @media (max-width: 360px) {
    .axis-ticks span:nth-child(2) { display: none; }
    .timing-overview { overflow-wrap: anywhere; }
  }
</style>
