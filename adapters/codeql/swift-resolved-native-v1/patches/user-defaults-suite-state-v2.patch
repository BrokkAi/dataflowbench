+/** Literal-key prototype: exact Foundation declarations, no display-string key parsing. */
+private predicate userDefaultsLiteralKey(MethodCallExpr call, string key, int position) {
+  exists(Method method |
+    call.getStaticTarget() = method and method.isInstanceMethod() and
+    method.getDeclaringDecl().asNominalTypeDecl().getModule().getName() = "Foundation" and
+    (
+      method.hasQualifiedName("Foundation", "UserDefaults", "set(_:forKey:)") and
+      method.getNumberOfParams() = 2 and position = 1
+      or
+      method.hasQualifiedName("Foundation", "UserDefaults", "string(forKey:)") and
+      method.getNumberOfParams() = 1 and position = 0
+    ) and
+    method.getParam(position).getType().(NominalType).getDeclaration().getModule().getName() = "Swift" and
+    method.getParam(position).getType().(NominalType).getDeclaration().getName() = "String" and
+    call.getArgument(position).getExpr().(StringLiteralExpr).getValue() = key
+  )
+}
+
+/** Reference origins use the resolver's CFG/SSA graph, independent of heap nodes. */
+private predicate referenceOrigin(CfgNode point, InitializerCallExpr origin) {
+  point.(ExprCfgNode).getExpr() = origin
+  or
+  exists(Ssa::Definition definition |
+    point = definition.getARead() and referenceDefinitionOrigin(definition, origin)
+  )
+  or
+  exists(CfgNode inner |
+    point.(ExprCfgNode).getExpr().(ForceValueExpr).getSubExpr() = inner.(ExprCfgNode).getExpr() and
+    point.getScope() = inner.getScope() and referenceOrigin(inner, origin)
+  )
+}
+
+private predicate referenceDefinitionOrigin(Ssa::Definition definition, InitializerCallExpr origin) {
+  exists(CfgNode value |
+    definition.(Ssa::WriteDefinition).assigns(value) and referenceOrigin(value, origin)
+  )
+  or
+  referenceDefinitionOrigin(definition.(Ssa::PhiDefinition).getAPhiInput(), origin)
+}
+
+private predicate userDefaultsSuite(MethodCallExpr call, string suite) {
+  exists(InitializerCallExpr init, Initializer target, StringLiteralExpr literal,
+      ApplyExprCfgNode point |
+    init.getStaticTarget() = target and
+    target.hasQualifiedName("Foundation", "UserDefaults", "init(suiteName:)") and
+    target.getDeclaringDecl().asNominalTypeDecl().getModule().getName() = "Foundation" and
+    target.getNumberOfParams() = 1 and
+    (init.getArgument(0).getExpr() = literal or
+     init.getArgument(0).getExpr().(InjectIntoOptionalExpr).convertsFrom(literal)) and
+    suite = literal.getValue() and point.getExpr() = call and
+    referenceOrigin(point.getQualifier(), init)
+  )
+}
+
+private predicate suiteOperation(CfgNode point, string suite) {
+  exists(MethodCallExpr call |
+    point.(ApplyExprCfgNode).getExpr() = call and
+    userDefaultsLiteralKey(call, _, _) and userDefaultsSuite(call, suite)
+  )
+}
+
+/** Follow CFG paths to the next operation in this suite, without bypassing writes. */
+private predicate nextSuiteOperation(CfgNode point, CfgNode next, string suite) {
+  exists(CfgNode successor | successor = point.getASuccessor() |
+    suiteOperation(successor, suite) and next = successor
+    or
+    not suiteOperation(successor, suite) and nextSuiteOperation(successor, next, suite)
+  )
+}
+
+private class UserDefaultsState extends NodeImpl, TUserDefaultsState {
+  CfgNode point;
+  string suite;
+  boolean post;
+  UserDefaultsState() { this = TUserDefaultsState(point, suite, post) }
+  CfgNode getPoint() { result = point }
+  string getSuite() { result = suite }
+  predicate isPost() { post = true }
+  override Location getLocationImpl() { result = point.getLocation() }
+  override string toStringImpl() { result = "UserDefaults suite " + suite + " post=" + post.toString() }
+  override DataFlowCallable getEnclosingCallable() { result = TDataFlowFunc(point.getScope()) }
+}
+
+private class UserDefaultsPostState extends UserDefaultsState, PostUpdateNodeImpl {
+  UserDefaultsPostState() { this.isPost() }
+  override Node getPreUpdateNode() {
+    result.(UserDefaultsState).getPoint() = this.getPoint() and
+    result.(UserDefaultsState).getSuite() = this.getSuite() and
+    not result.(UserDefaultsState).isPost()
+  }
+}
+
+predicate userDefaultsStateDomain(Node node, string suite, boolean post) {
+  suite = node.(UserDefaultsState).getSuite() and
+  (if node.(UserDefaultsState).isPost() then post = true else post = false)
+}
+
+predicate userDefaultsStateTransition(Node a, Node b) { suiteStateStep(a, b) }
+
+private predicate suiteStateStep(Node a, Node b) {
+  exists(UserDefaultsState before, UserDefaultsState after |
+    a = before and b = after and
+    before.getSuite() = after.getSuite() and
+    (
+      not before.isPost() and after.isPost() and before.getPoint() = after.getPoint()
+      or
+      before.isPost() and not after.isPost() and
+      nextSuiteOperation(before.getPoint(), after.getPoint(), before.getSuite())
+    )
+  )
+}
