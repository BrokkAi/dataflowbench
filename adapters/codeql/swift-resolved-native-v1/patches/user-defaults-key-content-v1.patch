+    method.getParam(position).getType().(NominalType).getDeclaration().getModule().getName() = "Swift" and
+    method.getParam(position).getType().(NominalType).getDeclaration().getName() = "String" and
+    call.getArgument(position).getExpr().(StringLiteralExpr).getValue() = key
+  )
 }
 
