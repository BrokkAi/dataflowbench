diff --git a/swift/extractor/infra/SwiftDispatcher.h b/swift/extractor/infra/SwiftDispatcher.h
index 65611de6e9..762bdb1c4e 100644
--- a/swift/extractor/infra/SwiftDispatcher.h
+++ b/swift/extractor/infra/SwiftDispatcher.h
@@ -238,6 +238,33 @@ class SwiftDispatcher {
     locationExtractor.attachLocation(sourceManager, comment, entry.id);
   }
 
+  // Match SILGenTopLevel::visitSourceFile's compiler declaration sequence.
+  // Module/lazy extraction and library-file lazy initializers are not entries.
+  void extractTopLevelEntry(swift::SourceFile& file) {
+    if (!file.isScriptMode()) return;
+    auto fileLabel = locationExtractor.emitFile(&file);
+    auto moduleLabel = fetchLabel(file.getParentModule());
+    TopLevelEntryPoint entry({});
+    entry.id = trap.createTypedLabel<TopLevelEntryPointTag>(
+        {"script-entry_", moduleLabel, "_", fileLabel});
+    entry.source_file = fileLabel;
+    entry.module = moduleLabel;
+    std::unordered_set<const swift::TopLevelCodeDecl*> seen;
+    auto append = [&](swift::Decl* declaration) {
+      if (auto* top = llvm::dyn_cast<swift::TopLevelCodeDecl>(declaration)) {
+        // Preserve label identity; never synthesize or duplicate declarations.
+        if (seen.insert(top).second) entry.declarations.push_back(fetchLabel(top));
+      }
+    };
+    for (auto* declaration : file.getTopLevelDecls()) {
+      declaration->visitAuxiliaryDecls(append);
+      append(declaration);
+    }
+    if (entry.declarations.empty()) return;
+    emit(entry);
+    visitPending();
+  }
+
  protected:
   void visitPending() {
     while (!toBeVisited.empty()) {
