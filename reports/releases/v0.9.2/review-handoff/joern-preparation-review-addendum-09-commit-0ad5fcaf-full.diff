+def _startup_lock_identity(fd: int) -> dict[str, int]:
+    import os
+    require(type(fd) is int and fd > 2, 'startup lock fd is invalid')
+    stat = os.fstat(fd)
+    return {'dev': stat.st_dev, 'ino': stat.st_ino}
