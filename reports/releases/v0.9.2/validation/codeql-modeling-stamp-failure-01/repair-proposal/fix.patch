+/// The current CodeQL producer and the version-aware validator must bind the
+/// same prospective v0.9.2 model query and profile. Historical CodeQL 2.27.0
+/// reports continue to derive the original artifact-only closure.
+#[test]
+pub(crate) fn codeql_modeling_configuration_matches_v092_validator_without_changing_history() {
+    let historical_paths =
+        crate::modeling::modeling_configuration_paths(ModelingTool::Codeql, ModelingLanguage::Java)
+            .unwrap()
+            .unwrap();
+    assert_eq!(
+        historical_paths,
+        BTreeSet::from([PathBuf::from("adapters/codeql/queries/JavaModeling.ql")])
+    );
+
+    let plan =
+        crate::modeling::plan_modeling_run(ModelingTool::Codeql, ModelingLanguage::Java).unwrap();
+    let expected_v092_paths = codeql_v092_configuration_paths(&historical_paths);
+    assert_eq!(plan.configuration_paths, expected_v092_paths);
+    assert!(
+        plan.configuration_paths
+            .contains(Path::new("adapters/codeql/v0.9.2/queries/JavaModeling.ql"))
+    );
+    assert!(
+        plan.configuration_paths
+            .contains(Path::new("adapters/codeql/v0.9.2/profile.json"))
+    );
+
+    let mut case_scan = None;
+    let validator_paths = current_configuration_paths("codeql-java-modeling", &mut case_scan)
+        .unwrap()
+        .unwrap();
+    assert_eq!(plan.configuration_paths, validator_paths);
+    let current_hash = hash_paths(&plan.configuration_paths).unwrap();
+    assert_eq!(
+        configuration_hash_state_for_report(
+            "codeql-java-modeling",
+            crate::adapters::pins::CODEQL_VERSION,
+            "0.1.0",
+            &current_hash,
+            &mut case_scan,
+        )
+        .unwrap(),
+        ConfigurationHashState::Current
+    );
+
+    let historical_hash = hash_paths(&historical_paths).unwrap();
+    assert_eq!(
+        configuration_hash_state_for_report(
+            "codeql-java-modeling",
+            "2.27.0",
+            "0.1.0",
+            &historical_hash,
+            &mut case_scan,
+        )
+        .unwrap(),
+        ConfigurationHashState::Current
+    );
 }
 
