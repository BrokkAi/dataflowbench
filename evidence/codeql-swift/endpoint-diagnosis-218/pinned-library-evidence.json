    "lines": [
      "private predicate hasExprNode(CfgNode n, Expr e) {",
      "  n.(ExprCfgNode).getExpr() = e",
      "  or",
      "  n.(PropertyGetterCfgNode).getRef() = e",
      "  or",
      "  n.(PropertySetterCfgNode).getAssignExpr() = e",
      "  or",
      "  n.(PropertyObserverCfgNode).getAssignExpr() = e",
      "}"
    ]
  }
