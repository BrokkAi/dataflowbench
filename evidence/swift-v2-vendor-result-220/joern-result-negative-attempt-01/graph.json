        "label": "METHOD",
        "file": "main.swift",
        "line": 12,
        "code": "func relay() -> Result<Int, FlowError> {\n    switch produce() {\n    case .failure(let error):\n        return .failure(error) // DFB-WITNESS: result-error-negative-relay\n    case .success(let value):\n        return .success(value)\n    }\n}"
