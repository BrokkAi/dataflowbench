        "line": 23,
        "code": "func probe() {\n    let clean = 0\n    switch relay() {\n    case .failure(let error):\n        let payload = error.value // DFB-WITNESS: result-error-negative-payload\n        dfb_sink(clean) // DFB-SINK: result-error-negative-sink\n        _ = payload\n    case .success:\n        break\n    }\n}"
