        "line": 7,
        "code": "func produce() -> Result<Int, FlowError> {\n    let input = dfb_source() // DFB-SOURCE: result-error-negative-input\n    return .failure(FlowError(value: input)) // DFB-WITNESS: result-error-negative-raise\n}"
